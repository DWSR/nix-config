digraph Dispatch {
    graph [
        goal="Scan {{ inputs.repo }} for ready issues, failing Dependabot pull requests, and open Kiro spec stack pull requests with unresolved review feedback; match each item against the dispatch rules, create child runs through the Fabro API bridge, then archive earlier successful dispatcher runs for the same repository.",
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    scan [
        label="Scan ready issues and dependabot PRs",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        goal_gate=true,
        script="import datetime, json, os, re, runpy, subprocess, sys, urllib.error, urllib.parse, urllib.request\n\nQUEUE_PATH = \".git/dispatch-queue.json\"\nSECURITY_SCAN_PATH = \".git/dispatch-security-scan.py\"\nAPI_BASE = os.environ.get(\"DISPATCH_API_BASE\", \"http://host.docker.internal:32276/api/v1\").rstrip(\"/\")\nGRAPHQL_URL = os.environ.get(\"DISPATCH_GITHUB_GRAPHQL_URL\", \"https://api.github.com/graphql\")\nFAILING_CONCLUSIONS = {\"FAILURE\", \"TIMED_OUT\"}\nRUNNING_CHECK_STATUSES = {\"QUEUED\", \"IN_PROGRESS\", \"WAITING\", \"REQUESTED\", \"PENDING\"}\nRUNNING_STATUS_STATES = {\"PENDING\", \"EXPECTED\"}\nSTALE_MINUTES = 30\n\n\ndef token():\n    value = os.environ.get(\"GITHUB_TOKEN\", \"\")\n    if not value:\n        sys.exit(\"GITHUB_TOKEN is not set; declare [run.integrations.github.permissions] on this workflow\")\n    return value\n\n\ndef github(method, path):\n    base = os.environ.get(\"DISPATCH_GITHUB_API_BASE\", \"https://api.github.com\").rstrip(\"/\")\n    req = urllib.request.Request(base + path, method=method, headers={\n        \"Authorization\": \"Bearer %s\" % token(),\n        \"Accept\": \"application/vnd.github+json\",\n        \"X-GitHub-Api-Version\": \"2026-03-10\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            raw = r.read()\n            return json.loads(raw) if raw else []\n    except urllib.error.HTTPError as e:\n        sys.exit(\"GitHub API %s %s failed: HTTP %s\\n%s\" % (method, path, e.code, e.read().decode(\"utf-8\", \"replace\")[:1000]))\n\n\ndef github_delete(path):\n    base = os.environ.get(\"DISPATCH_GITHUB_API_BASE\", \"https://api.github.com\").rstrip(\"/\")\n    req = urllib.request.Request(base + path, method=\"DELETE\", headers={\n        \"Authorization\": \"Bearer %s\" % token(),\n        \"Accept\": \"application/vnd.github+json\",\n        \"X-GitHub-Api-Version\": \"2026-03-10\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            r.read()\n            return r.status\n    except urllib.error.HTTPError as e:\n        if e.code == 404:\n            return 404\n        print(\"dispatch scan: label cleanup failed for %s: HTTP %s %s\" % (path, e.code, e.read().decode(\"utf-8\", \"replace\")[:300]), file=sys.stderr)\n        return e.code\n\n\ndef graphql(query, variables):\n    req = urllib.request.Request(GRAPHQL_URL, method=\"POST\", data=json.dumps({\"query\": query, \"variables\": variables}).encode(), headers={\n        \"Authorization\": \"Bearer %s\" % token(),\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            return json.loads(r.read() or b\"{}\")\n    except urllib.error.HTTPError as e:\n        sys.exit(\"GitHub GraphQL failed: HTTP %s\\n%s\" % (e.code, e.read().decode(\"utf-8\", \"replace\")[:1000]))\n\n\ndef fabro_runs():\n    query = urllib.parse.urlencode([\n        (\"page[limit]\", \"100\"),\n        (\"status\", \"pending\"),\n        (\"status\", \"runnable\"),\n        (\"status\", \"initializing\"),\n        (\"status\", \"running\"),\n        (\"status\", \"blocked\"),\n    ])\n    req = urllib.request.Request(API_BASE + \"/runs?\" + query, method=\"GET\", headers={\n        \"Accept\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            return (json.loads(r.read() or b\"{}\") or {}).get(\"data\") or []\n    except urllib.error.HTTPError as e:\n        sys.exit(\"Fabro API GET /runs failed: HTTP %s\\n%s\" % (e.code, e.read().decode(\"utf-8\", \"replace\")[:1000]))\n\n\ndef origin_repo():\n    url = subprocess.run([\"git\", \"config\", \"--get\", \"remote.origin.url\"], capture_output=True, text=True).stdout.strip()\n    m = re.match(r\"(?:https://github\\.com/|git@github\\.com:)([^/]+)/([^/]+?)(?:\\.git)?/?$\", url)\n    if not m:\n        sys.exit(\"cannot derive owner/repo from origin url %r; pass -I repo=<owner/name>\" % url)\n    return m.group(1), m.group(2)\n\n\ndef run_pr_number(run):\n    labels = run.get(\"labels\") or {}\n    value = labels.get(\"pr\") if isinstance(labels, dict) else None\n    if value is not None:\n        m = re.search(r\"(\\d+)\", str(value))\n        if m:\n            return int(m.group(1))\n    m = re.search(r\"pull request (\\d+)\", run.get(\"goal\") or \"\")\n    return int(m.group(1)) if m else None\n\n\nPR_QUERY = \"\"\"\nquery($owner:String!,$repo:String!,$number:Int!){\n  repository(owner:$owner,name:$repo){\n    pullRequest(number:$number){\n      number\n      headRefOid\n      mergeable\n      mergeStateStatus\n      autoMergeRequest{enabledAt}\n      commits(last:1){nodes{commit{\n        committedDate\n        statusCheckRollup{\n          state\n          contexts(first:100){nodes{\n            __typename\n            ... on CheckRun{name conclusion status detailsUrl startedAt completedAt}\n            ... on StatusContext{context state targetUrl}\n          }}\n        }\n      }}}\n    }\n  }\n}\n\"\"\"\n\n\ndef pull_request_detail(repo_slug, number):\n    owner, repo = repo_slug.split(\"/\", 1)\n    body = graphql(PR_QUERY, {\"owner\": owner, \"repo\": repo, \"number\": number})\n    errors = (body or {}).get(\"errors\")\n    if errors:\n        sys.exit(\"GitHub GraphQL pull request %s#%d failed: %s\" % (repo_slug, number, json.dumps(errors)[:1000]))\n    return (((body or {}).get(\"data\") or {}).get(\"repository\") or {}).get(\"pullRequest\")\n\n\ndef analyze_pull_request(pr):\n    node = ((pr.get(\"commits\") or {}).get(\"nodes\") or [{}])[-1]\n    commit = node.get(\"commit\") or {}\n    rollup = commit.get(\"statusCheckRollup\") or {}\n    contexts = ((rollup.get(\"contexts\") or {}).get(\"nodes\") or [])\n    conflict = pr.get(\"mergeable\") == \"CONFLICTING\" or pr.get(\"mergeStateStatus\") == \"DIRTY\"\n    unknown = pr.get(\"mergeable\") == \"UNKNOWN\" or pr.get(\"mergeStateStatus\") == \"UNKNOWN\"\n    running = rollup.get(\"state\") in (\"PENDING\", \"EXPECTED\")\n    failures = []\n    for ctx in contexts:\n        kind = ctx.get(\"__typename\")\n        if kind == \"CheckRun\":\n            if ctx.get(\"status\") in RUNNING_CHECK_STATUSES:\n                running = True\n            if ctx.get(\"conclusion\") in FAILING_CONCLUSIONS:\n                failures.append({\"name\": ctx.get(\"name\") or \"\", \"conclusion\": ctx.get(\"conclusion\") or \"\", \"detailsUrl\": ctx.get(\"detailsUrl\") or \"\"})\n        elif kind == \"StatusContext\":\n            if ctx.get(\"state\") in RUNNING_STATUS_STATES:\n                running = True\n            if ctx.get(\"state\") in (\"ERROR\", \"FAILURE\"):\n                failures.append({\"name\": ctx.get(\"context\") or \"\", \"conclusion\": ctx.get(\"state\") or \"\", \"detailsUrl\": ctx.get(\"targetUrl\") or \"\"})\n    stalled = False\n    committed = commit.get(\"committedDate\")\n    if conflict and running and committed:\n        try:\n            stamp = datetime.datetime.fromisoformat(committed.replace(\"Z\", \"+00:00\"))\n            stalled = (datetime.datetime.now(datetime.timezone.utc) - stamp).total_seconds() > STALE_MINUTES * 60\n        except ValueError:\n            stalled = False\n    if stalled:\n        running = False\n    ci_failing = bool(failures)\n    if conflict and ci_failing:\n        reason = \"both\"\n    elif conflict:\n        reason = \"merge_conflict\"\n    else:\n        reason = \"ci_failure\"\n    return {\n        \"ci_running\": running,\n        \"ci_failing\": ci_failing,\n        \"conflict\": conflict,\n        \"unknown\": unknown,\n        \"reason\": reason,\n        \"failures\": failures[:20],\n    }\n\n\nrepo_in = {{ inputs.repo }}.strip()\nready = {{ inputs.ready_label }}.strip()\nrunning = {{ inputs.running_label }}.strip()\nfailed = {{ inputs.failed_label }}.strip()\n\nif not ready:\n    sys.exit(\"input 'ready_label' is empty; pass the label that marks issues as ready, for example -I ready_label=fabro-ready\")\nif not running:\n    sys.exit(\"input 'running_label' is empty; pass the label that marks dispatched items, for example -I running_label=fabro-running\")\n\nif repo_in:\n    m = re.match(r\"^([^/\\s]+)/([^/\\s]+?)(?:\\.git)?$\", repo_in)\n    if not m:\n        sys.exit(\"input 'repo' must be owner/name; got %r\" % repo_in)\n    owner, repo = m.group(1), m.group(2)\nelse:\n    owner, repo = origin_repo()\n\nrepo_slug = \"%s/%s\" % (owner, repo)\ninfo = github(\"GET\", \"/repos/%s\" % repo_slug) or {}\ndefault_branch = info.get(\"default_branch\") or \"main\"\n\nissues = []\npage = 1\nwhile page <= 10:\n    q = urllib.parse.urlencode({\"state\": \"open\", \"labels\": ready, \"per_page\": 100, \"page\": page})\n    batch = github(\"GET\", \"/repos/%s/issues?%s\" % (repo_slug, q)) or []\n    issues.extend(i for i in batch if not i.get(\"pull_request\"))\n    if len(batch) < 100:\n        break\n    page += 1\n\nissues.sort(key=lambda i: i.get(\"number\", 0))\n\nruns = fabro_runs()\nactive = {}\nfor run in runs:\n    if ((run.get(\"workflow\") or {}).get(\"slug\") or \"\") != \"dependabot\":\n        continue\n    if (((run.get(\"repository\") or {}).get(\"name\") or \"\").lower()) != repo_slug.lower():\n        continue\n    number = run_pr_number(run)\n    if number is not None:\n        active[number] = run.get(\"id\")\n\npull_requests = []\nskipper = {\"running\": 0, \"failed\": 0, \"ci_running\": 0, \"passing\": 0, \"stale_running\": 0, \"unknown\": 0}\npage = 1\nwhile page <= 10:\n    q = urllib.parse.urlencode({\"state\": \"open\", \"base\": default_branch, \"per_page\": 100, \"page\": page, \"sort\": \"created\", \"direction\": \"asc\"})\n    batch = github(\"GET\", \"/repos/%s/pulls?%s\" % (repo_slug, q)) or []\n    for pr in batch:\n        if (pr.get(\"user\") or {}).get(\"login\") != \"dependabot[bot]\":\n            continue\n        if pr.get(\"draft\"):\n            continue\n        head = pr.get(\"head\") or {}\n        if ((head.get(\"repo\") or {}).get(\"full_name\") or \"\") != repo_slug:\n            continue\n        number = pr[\"number\"]\n        labels = [l.get(\"name\") for l in (pr.get(\"labels\") or []) if l.get(\"name\")]\n        if failed and failed in labels:\n            skipper[\"failed\"] += 1\n            continue\n        if running in labels and number not in active:\n            label_path = \"/repos/%s/issues/%d/labels/%s\" % (repo_slug, number, urllib.parse.quote(running, safe=\"\"))\n            if github_delete(label_path) in (200, 204, 404):\n                labels = [label for label in labels if label != running]\n                skipper[\"stale_running\"] += 1\n                print(\"dispatch scan: removed stale %s from %s#%d\" % (running, repo_slug, number), file=sys.stderr)\n        if running in labels:\n            skipper[\"running\"] += 1\n            continue\n        if number in active:\n            skipper[\"running\"] += 1\n            continue\n        detail = pull_request_detail(repo_slug, number)\n        if not detail:\n            skipper[\"unknown\"] += 1\n            continue\n        state = analyze_pull_request(detail)\n        if state[\"unknown\"]:\n            skipper[\"unknown\"] += 1\n            continue\n        if state[\"ci_running\"]:\n            skipper[\"ci_running\"] += 1\n            continue\n        if not state[\"ci_failing\"] and not state[\"conflict\"]:\n            skipper[\"passing\"] += 1\n            continue\n        pull_requests.append({\n            \"number\": number,\n            \"title\": (pr.get(\"title\") or \"\").strip(),\n            \"url\": pr.get(\"html_url\", \"\"),\n            \"head_ref\": head.get(\"ref\") or \"\",\n            \"labels\": labels,\n            \"reason\": state[\"reason\"],\n            \"ci_failures\": json.dumps(state[\"failures\"], separators=(\",\", \":\")),\n        })\n    if len(batch) < 100:\n        break\n    page += 1\n\npull_requests.sort(key=lambda p: p.get(\"number\", 0))\n\nqueue = {\n    \"repo\": repo_slug,\n    \"ready_label\": ready,\n    \"running_label\": running,\n    \"failed_label\": failed,\n    \"default_branch\": default_branch,\n    \"issues\": [\n        {\n            \"number\": i[\"number\"],\n            \"title\": (i.get(\"title\") or \"\").strip(),\n            \"url\": i.get(\"html_url\", \"\"),\n            \"labels\": [l.get(\"name\") for l in (i.get(\"labels\") or []) if l.get(\"name\")],\n        }\n        for i in issues\n    ],\n    \"pull_requests\": pull_requests,\n}\nif not os.path.exists(SECURITY_SCAN_PATH):\n    sys.exit(\"dispatch scan: %s is missing (fresh sandbox on resume?); start a new run instead of resuming this one\" % SECURITY_SCAN_PATH)\nsecurity = runpy.run_path(SECURITY_SCAN_PATH)[\"scan\"](repo_slug, github, runs)\nqueue[\"findings\"] = security[\"findings\"]\nqueue[\"remediation\"] = security[\"remediation\"]\nwith open(QUEUE_PATH, \"w\") as f:\n    json.dump(queue, f, indent=1, sort_keys=True)\n\nselected = security[\"remediation\"].get(\"selected\") or {}\nactive_security_run = security[\"remediation\"].get(\"active_run\") or \"\"\nhas_queue = bool(queue[\"issues\"] or queue[\"pull_requests\"] or queue[\"findings\"])\nprint(\"dispatch scan: repo=%s issues=%d dependabot_prs=%d active_runs=%d findings=%d selected=%s skipped=%s\" % (\n    queue[\"repo\"], len(queue[\"issues\"]), len(queue[\"pull_requests\"]), len(active), len(queue[\"findings\"]),\n    (\"%s:%s\" % (selected[\"source\"], selected[\"number\"])) if selected else \"none\", json.dumps(skipper, sort_keys=True)), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"has_queue\": \"true\" if has_queue else \"false\",\n    \"has_issues\": \"true\" if queue[\"issues\"] else \"false\",\n    \"has_pull_requests\": \"true\" if queue[\"pull_requests\"] else \"false\",\n    \"issue_count\": str(len(queue[\"issues\"])),\n    \"pull_request_count\": str(len(queue[\"pull_requests\"])),\n    \"active_dependabot_runs\": str(len(active)),\n    \"finding_count\": str(len(queue[\"findings\"])),\n    \"finding_source\": selected.get(\"source\") or \"\",\n    \"finding_number\": str(selected[\"number\"]) if selected else \"\",\n    \"active_security_remediation_run\": str(active_security_run),\n}}))"
    ]

    match [
        label="Match dispatch rules",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import json, sys\n\nQUEUE_PATH = \".git/dispatch-queue.json\"\nPLAN_PATH = \".git/dispatch-plan.json\"\n\nRULES = [\n    {\"label\": \"type/kiro-spec\", \"workflow\": \"kiro-spec\", \"workflow_version_id\": {{ vars.kiro_spec_workflow_version }}, \"label_swap\": \"dispatcher\", \"input_key\": \"issue\"},\n    {\"label\": \"type/oneshot\", \"workflow\": \"oneshot\", \"workflow_version_id\": {{ vars.oneshot_workflow_version }}, \"label_swap\": \"child\", \"input_key\": \"issue\"},\n]\nDEPENDABOT_RULE = {\n    \"workflow\": \"dependabot\",\n    \"workflow_version_id\": {{ vars.dependabot_workflow_version }},\n    \"label_swap\": \"dispatcher\",\n    \"input_key\": \"pr\",\n}\nREMEDIATION_RULE = {\n    \"workflow\": \"security-remediation\",\n    \"workflow_version_id\": {{ vars.security_remediation_workflow_version }},\n    \"input_key\": \"finding\",\n}\n\nqueue = json.load(open(QUEUE_PATH))\nentries, ambiguous, skipped = [], [], []\nfor issue in queue[\"issues\"]:\n    labels = issue.get(\"labels\") or []\n    matched = [r for r in RULES if r[\"label\"] in labels]\n    if len(matched) == 1:\n        rule = matched[0]\n        entries.append({\n            \"kind\": \"issue\",\n            \"number\": issue[\"number\"],\n            \"title\": issue.get(\"title\", \"\"),\n            \"url\": issue.get(\"url\", \"\"),\n            \"workflow\": rule[\"workflow\"],\n            \"workflow_version_id\": rule[\"workflow_version_id\"],\n            \"input_key\": rule[\"input_key\"],\n            \"label_swap\": rule[\"label_swap\"],\n        })\n    elif len(matched) > 1:\n        ambiguous.append({\"number\": issue[\"number\"], \"labels\": sorted(r[\"label\"] for r in matched)})\n    else:\n        skipped.append({\"number\": issue[\"number\"], \"labels\": sorted(labels)})\n\npull_requests = queue.get(\"pull_requests\") or []\nfor pr in pull_requests:\n    entries.append({\n        \"kind\": \"pr\",\n        \"number\": pr[\"number\"],\n        \"title\": pr.get(\"title\", \"\"),\n        \"url\": pr.get(\"url\", \"\"),\n        \"workflow\": DEPENDABOT_RULE[\"workflow\"],\n        \"workflow_version_id\": DEPENDABOT_RULE[\"workflow_version_id\"],\n        \"input_key\": DEPENDABOT_RULE[\"input_key\"],\n        \"label_swap\": DEPENDABOT_RULE[\"label_swap\"],\n        \"ci_failures\": pr.get(\"ci_failures\", \"\"),\n        \"reason\": pr.get(\"reason\", \"\"),\n    })\n\nremediation = queue.get(\"remediation\") or {}\nselected = remediation.get(\"selected\")\nif selected and not remediation.get(\"active_run\"):\n    entries.append({\n        \"kind\": \"finding\",\n        \"number\": \"%s:%s\" % (selected[\"source\"], selected[\"number\"]),\n        \"alert_source\": selected[\"source\"],\n        \"alert_number\": selected[\"number\"],\n        \"title\": selected.get(\"title\", \"\"),\n        \"url\": selected.get(\"url\", \"\"),\n        \"workflow\": REMEDIATION_RULE[\"workflow\"],\n        \"workflow_version_id\": REMEDIATION_RULE[\"workflow_version_id\"],\n        \"input_key\": REMEDIATION_RULE[\"input_key\"],\n        \"label_swap\": \"none\",\n    })\n\nplan = {\n    \"repo\": queue[\"repo\"],\n    \"default_branch\": queue[\"default_branch\"],\n    \"entries\": entries,\n    \"ambiguous\": ambiguous,\n    \"skipped\": skipped,\n}\nwith open(PLAN_PATH, \"w\") as f:\n    json.dump(plan, f, indent=1, sort_keys=True)\n\nfor entry in skipped:\n    print(\"dispatch match: skipping %s#%s (labels %s match no rule)\" % (queue[\"repo\"], entry[\"number\"], entry[\"labels\"]), file=sys.stderr)\n\nif ambiguous:\n    details = \", \".join(\"#%s (%s)\" % (a[\"number\"], \"+\".join(a[\"labels\"])) for a in ambiguous)\n    sys.exit(\"dispatch match: ambiguous type labels on %s; refusing to dispatch the batch: %s\" % (queue[\"repo\"], details))\n\nfinding_count = sum(1 for entry in entries if entry[\"kind\"] == \"finding\")\nprint(\"dispatch match: repo=%s matched=%d (issues=%d, prs=%d, findings=%d) skipped=%d\" % (\n    queue[\"repo\"], len(entries), len(entries) - len(pull_requests) - finding_count, len(pull_requests), finding_count, len(skipped)), file=sys.stderr)\nprint(json.dumps({\"context_updates\": {\n    \"has_plan\": \"true\" if entries else \"false\",\n    \"matched_count\": str(len(entries)),\n    \"skipped_count\": str(len(skipped)),\n}}))"
    ]

    stack_scan [
        label="Scan open Kiro spec stacks for review feedback",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import runpy\nrunpy.run_path('.git/dispatch-stack-scan.py', run_name='__main__')"
    ]

    normalize [
        label="Mark stack reruns as label-neutral",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import json\n\nqueue = json.load(open('.git/dispatch-queue.json'))\nplan = json.load(open('.git/dispatch-plan.json'))\nstack_issue_numbers = {item['issue'] for item in (queue.get('kiro_spec_issues') or [])}\nfor entry in plan.get('entries') or []:\n    if entry.get('kind') == 'issue' and entry.get('number') in stack_issue_numbers:\n        entry['label_swap'] = 'none'\n        entry['source'] = 'open_kiro_spec_stack'\njson.dump(plan, open('.git/dispatch-plan.json', 'w'), indent=1, sort_keys=True)\nprint(json.dumps({'context_updates': {'has_plan': 'true' if plan.get('entries') else 'false'}}))"
    ]

    dispatch [
        label="Dispatch child runs",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import json, os, sys, urllib.error, urllib.parse, urllib.request\n\nPLAN_PATH = \".git/dispatch-plan.json\"\nRESULT_PATH = \".git/dispatch-result.json\"\nAPI_BASE = os.environ.get(\"DISPATCH_API_BASE\", \"http://host.docker.internal:32276/api/v1\").rstrip(\"/\")\nREADY = {{ inputs.ready_label }}.strip()\nRUNNING = {{ inputs.running_label }}.strip()\n\n\ndef api(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(API_BASE + path, method=method, data=data, headers={\n        \"Accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=120) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", \"replace\")[:500]\n        raise RuntimeError(\"HTTP %s from %s %s: %s\" % (e.code, method, path, detail))\n\n\ndef gh(method, path, body=None):\n    token = os.environ.get(\"GITHUB_TOKEN\", \"\")\n    if not token:\n        raise RuntimeError(\"GITHUB_TOKEN is not set\")\n    base = os.environ.get(\"DISPATCH_GITHUB_API_BASE\", \"https://api.github.com\").rstrip(\"/\")\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(base + path, method=method, data=data, headers={\n        \"Authorization\": \"Bearer %s\" % token,\n        \"Accept\": \"application/vnd.github+json\",\n        \"X-GitHub-Api-Version\": \"2026-03-10\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=60) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", \"replace\")[:500]\n        raise RuntimeError(\"GitHub API HTTP %s from %s %s: %s\" % (e.code, method, path, detail))\n\n\ndef active_dependabot_run(repo):\n    query = urllib.parse.urlencode([\n        (\"page[limit]\", \"100\"),\n        (\"status\", \"pending\"),\n        (\"status\", \"runnable\"),\n        (\"status\", \"initializing\"),\n        (\"status\", \"running\"),\n        (\"status\", \"blocked\"),\n    ])\n    _, body = api(\"GET\", \"/runs?\" + query)\n    for run in (body or {}).get(\"data\") or []:\n        if ((run.get(\"workflow\") or {}).get(\"slug\") or \"\") != \"dependabot\":\n            continue\n        if (((run.get(\"repository\") or {}).get(\"name\") or \"\").lower()) != repo.lower():\n            continue\n        return run.get(\"id\")\n    return None\n\n\nplan = json.load(open(PLAN_PATH))\nrepo = plan[\"repo\"]\nbranch = plan[\"default_branch\"]\nresult = {\"repo\": repo, \"dispatched\": [], \"failed\": [], \"skipped\": plan.get(\"skipped\", [])}\n\n\ndef save():\n    with open(RESULT_PATH, \"w\") as f:\n        json.dump(result, f, indent=1, sort_keys=True)\n\n\nactive = active_dependabot_run(repo)\nif active:\n    result[\"active_dependabot_run\"] = active\n    print(\"dispatch: skipping dependabot PRs for %s; active run %s\" % (repo, active), file=sys.stderr)\ndependabot_dispatched = False\nsave()\nfor entry in plan[\"entries\"]:\n    number = str(entry[\"number\"])\n    kind = entry.get(\"kind\", \"issue\")\n    input_key = entry.get(\"input_key\", \"issue\")\n    if kind == \"pr\":\n        if active:\n            result[\"skipped\"].append({\"pr\": number, \"reason\": \"active_dependabot_run\"})\n            save()\n            continue\n        if dependabot_dispatched:\n            result[\"skipped\"].append({\"pr\": number, \"reason\": \"serialized\"})\n            save()\n            continue\n    inputs = {input_key: number}\n    labels = {\"source\": \"dispatch\", \"repo\": repo, kind: number}\n    if kind == \"pr\":\n        inputs[\"ci_failures\"] = entry.get(\"ci_failures\", \"\")\n        inputs[\"reason\"] = entry.get(\"reason\", \"\")\n        if entry.get(\"reason\"):\n            labels[\"reason\"] = entry[\"reason\"]\n    try:\n        status, run = api(\"POST\", \"/runs\", {\n            \"workflow_version_id\": entry[\"workflow_version_id\"],\n            \"title\": \"%s for %s#%s\" % (entry[\"workflow\"], repo, number),\n            \"target\": {\"kind\": \"git\", \"repo\": repo, \"branch\": branch},\n            \"args\": {\n                \"inputs\": inputs,\n                \"labels\": labels,\n                \"auto_approve\": True,\n            },\n        })\n        run_id = (run or {}).get(\"id\") or (run or {}).get(\"run_id\")\n        if not run_id:\n            raise RuntimeError(\"run create returned no run id: %r\" % run)\n        api(\"POST\", \"/runs/%s/start\" % run_id, {})\n        item = {kind: number, \"workflow\": entry[\"workflow\"], \"run_id\": run_id}\n        if entry[\"label_swap\"] == \"dispatcher\":\n            try:\n                gh(\"POST\", \"/repos/%s/issues/%s/labels\" % (repo, number), {\"labels\": [RUNNING]})\n                if kind != \"pr\":\n                    gh(\"DELETE\", \"/repos/%s/issues/%s/labels/%s\" % (repo, number, urllib.parse.quote(READY, safe=\"\")))\n            except Exception as e:\n                item[\"label_error\"] = str(e)[:500]\n        if kind == \"pr\":\n            dependabot_dispatched = True\n        result[\"dispatched\"].append(item)\n    except Exception as e:\n        result[\"failed\"].append({kind: number, \"error\": str(e)[:500]})\n    save()\n\nprint(\"dispatch: repo=%s dispatched=%d failed=%d skipped=%d\" % (repo, len(result[\"dispatched\"]), len(result[\"failed\"]), len(result[\"skipped\"])), file=sys.stderr)\nfor failure in result[\"failed\"]:\n    print(\"dispatch: failed %s#%s: %s\" % (repo, failure.get(\"issue\") or failure.get(\"pr\"), failure[\"error\"]), file=sys.stderr)\nif result[\"failed\"]:\n    print(json.dumps({\"context_updates\": {\n        \"dispatch_result\": \"failed\",\n        \"dispatched_count\": str(len(result[\"dispatched\"])),\n        \"failed_count\": str(len(result[\"failed\"])),\n    }}))\n    sys.exit(1)\nprint(json.dumps({\"context_updates\": {\n    \"dispatch_result\": \"success\",\n    \"dispatched_count\": str(len(result[\"dispatched\"])),\n    \"failed_count\": \"0\",\n}}))"
    ]

    prune [
        label="Archive previous successful dispatch runs",
        shape=parallelogram,
        language="python",
        output_schema="routing",
        script="import json, os, sys, urllib.error, urllib.request\n\nQUEUE_PATH = \".git/dispatch-queue.json\"\nARCHIVE_PATH = \".git/dispatch-archive.json\"\nAPI_BASE = os.environ.get(\"DISPATCH_API_BASE\", \"http://host.docker.internal:32276/api/v1\").rstrip(\"/\")\nWORKFLOW_SLUG = \"dispatch\"\nMAX_PAGES = 200\n\n\ndef api(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    req = urllib.request.Request(API_BASE + path, method=method, data=data, headers={\n        \"Accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n        \"User-Agent\": \"fabro-dispatch-workflow\",\n    })\n    try:\n        with urllib.request.urlopen(req, timeout=120) as r:\n            raw = r.read()\n            return r.status, (json.loads(raw) if raw else None)\n    except urllib.error.HTTPError as e:\n        detail = e.read().decode(\"utf-8\", \"replace\")[:500]\n        raise RuntimeError(\"HTTP %s from %s %s: %s\" % (e.code, method, path, detail))\n\n\ndef previous_successful_runs(repo):\n    run_ids = []\n    offset = 0\n    for _ in range(MAX_PAGES):\n        path = \"/runs?status=succeeded&page%5Blimit%5D=100&page%5Boffset%5D=\" + str(offset)\n        _, body = api(\"GET\", path)\n        page = (body or {}).get(\"data\") or []\n        for run in page:\n            if ((run.get(\"workflow\") or {}).get(\"slug\") or \"\") != WORKFLOW_SLUG:\n                continue\n            if (((run.get(\"repository\") or {}).get(\"name\") or \"\").lower()) != repo.lower():\n                continue\n            if (run.get(\"lifecycle\") or {}).get(\"archived\"):\n                continue\n            run_ids.append(run[\"id\"])\n        if not page or not ((body or {}).get(\"meta\") or {}).get(\"has_more\"):\n            return run_ids\n        offset += len(page)\n    sys.exit(\"dispatch prune: gave up listing runs after %d pages; raise MAX_PAGES or prune the backlog manually\" % MAX_PAGES)\n\n\nqueue = json.load(open(QUEUE_PATH))\nrepo = queue[\"repo\"]\n\nprevious = previous_successful_runs(repo)\narchived, failed = [], []\nfor run_id in previous:\n    try:\n        api(\"POST\", \"/runs/%s/archive\" % run_id)\n        archived.append(run_id)\n    except Exception as e:\n        failed.append({\"run_id\": run_id, \"error\": str(e)[:300]})\n\nwith open(ARCHIVE_PATH, \"w\") as f:\n    json.dump({\"repo\": repo, \"archived\": archived, \"failed\": failed}, f, indent=1, sort_keys=True)\n\nfor failure in failed:\n    print(\"dispatch prune: failed to archive %s: %s\" % (failure[\"run_id\"], failure[\"error\"]), file=sys.stderr)\nprint(\"dispatch prune: repo=%s previous=%d archived=%d failed=%d\" % (repo, len(previous), len(archived), len(failed)), file=sys.stderr)\nif failed:\n    print(json.dumps({\"context_updates\": {\n        \"archive_result\": \"failed\",\n        \"archived_count\": str(len(archived)),\n        \"archive_failed_count\": str(len(failed)),\n    }}))\n    sys.exit(1)\nprint(json.dumps({\"context_updates\": {\n    \"archive_result\": \"success\",\n    \"archived_count\": str(len(archived)),\n}}))\n"
    ]

    // No goal_gate here: Fabro checks every declared goal gate when a run
    // reaches exit, and an unvisited gate fails the run. `fail` only runs on
    // failure paths, so gating it broke every successful dispatch. Its exit
    // code already decides the run, and on_failure="exit" ends a failed run
    // instead of routing the failure through exit as a success.
    fail [
        label="Fail run",
        shape=parallelogram,
        stdin_source="stage_failure",
        on_failure="exit",
        script="set -eu\nMSG=$(cat || true)\nif [ -z \"$MSG\" ]; then\n  MSG=\"a dispatch stage failed; inspect the failing stage output in the run events and .git/dispatch-queue.json, .git/dispatch-plan.json, .git/dispatch-result.json, .git/dispatch-archive.json\"\nfi\nprintf 'dispatch: %s\\n' \"$MSG\" >&2\nexit 1"
    ]

    start -> scan

    scan -> stack_scan [condition="outcome=succeeded"]
    scan -> fail

    stack_scan -> match [condition="outcome=succeeded && context.has_queue=true"]
    stack_scan -> prune [condition="outcome=succeeded && context.has_queue=false"]
    stack_scan -> fail

    match -> normalize [condition="outcome=succeeded"]
    match -> fail

    normalize -> dispatch [condition="outcome=succeeded && context.has_plan=true"]
    normalize -> prune [condition="outcome=succeeded && context.has_plan=false"]
    normalize -> fail

    dispatch -> prune [condition="outcome=succeeded"]
    dispatch -> fail

    prune -> exit [condition="outcome=succeeded"]
    prune -> fail

    fail -> exit
}
