digraph Oneshot {
    graph [
        goal="Implement GitHub issue {{ inputs.issue }} as a oneshot change: implement it, keep the Git diff under 1000 lines (simplifying at most twice), review it adversarially, and open a pull request whose body closes the issue.",
        stall_timeout="60m",
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    setup_helpers [
        label="Prepare workflow helpers",
        shape=parallelogram,
        timeout="5m",
        on_failure="exit",
        max_retries=0,
        script="set -eu\nmkdir -p .git/oneshot-scripts\ncp .fabro/workflows/oneshot/scripts/tools.py .git/oneshot-scripts/tools.py\npython3 -c \"import py_compile; py_compile.compile('.git/oneshot-scripts/tools.py', doraise=True)\""
    ]

    prepare [
        label="Validate labels and prepare",
        shape=parallelogram,
        output_schema="routing",
        timeout="10m",
        script="test -f .git/oneshot-scripts/tools.py || { echo 'oneshot: helper scripts are missing (fresh sandbox on resume?); start a new run instead of resuming this one' >&2; exit 1; }\npython3 .git/oneshot-scripts/tools.py prepare {{ inputs.issue }}"
    ]

    diagnose [
        label="Probe run environment",
        shape=parallelogram,
        output_schema="routing",
        timeout="2m",
        script="python3 .git/oneshot-scripts/tools.py diagnose {{ inputs.issue }}"
    ]

    baseline [
        label="Precompute baseline checks",
        shape=parallelogram,
        output_schema="routing",
        timeout="10m",
        on_failure="exit",
        max_retries=0,
        script="python3 .git/oneshot-scripts/tools.py baseline"
    ]

    implement [
        label="Implement issue",
        prompt="@prompts/implement.md",
        output_schema="routing",
        max_visits=8,
        max_retries=2,
        retry_policy="patient",
        timeout="45m"
    ]

    check [
        label="Check diff size",
        shape=parallelogram,
        output_schema="routing",
        max_visits=6,
        timeout="5m",
        script="python3 .git/oneshot-scripts/tools.py check"
    ]

    simplify [
        label="Simplify change",
        prompt="@prompts/simplify.md",
        output_schema="routing",
        max_visits=5,
        max_retries=2,
        retry_policy="patient",
        timeout="30m"
    ]

    review [
        label="Review change",
        prompt="@prompts/review.md",
        output_schema="routing",
        max_visits=8,
        max_retries=2,
        retry_policy="patient",
        timeout="30m"
    ]

    rework [
        label="Queue rework",
        shape=parallelogram,
        output_schema="routing",
        max_visits=3,
        stdin_source="context.rework_round",
        script="set -eu\nROUND=$(cat 2>/dev/null | tr -d '[:space:]' || true)\ncase \"$ROUND\" in ''|*[!0-9]*) ROUND=0 ;; esac\nROUND=$((ROUND + 1))\nprintf '{\"outcome\":\"succeeded\",\"context_updates\":{\"rework_round\":\"%s\"}}\\n' \"$ROUND\""
    ]

    wait_implement_rate_limit [
        label="Wait for rate limit (implement)",
        shape=parallelogram,
        output_schema="routing",
        timeout="6m",
        max_visits=3,
        script="sleep 300\nprintf '{\"outcome\":\"succeeded\"}\\n'"
    ]

    wait_simplify_rate_limit [
        label="Wait for rate limit (simplify)",
        shape=parallelogram,
        output_schema="routing",
        timeout="6m",
        max_visits=3,
        script="sleep 300\nprintf '{\"outcome\":\"succeeded\"}\\n'"
    ]

    wait_review_rate_limit [
        label="Wait for rate limit (review)",
        shape=parallelogram,
        output_schema="routing",
        timeout="6m",
        max_visits=3,
        script="sleep 300\nprintf '{\"outcome\":\"succeeded\"}\\n'"
    ]

    publish [
        label="Publish pull request",
        shape=parallelogram,
        timeout="15m",
        script="python3 .git/oneshot-scripts/tools.py publish"
    ]

    salvage [
        label="Salvage draft pull request",
        shape=parallelogram,
        stdin_source="stage_failure",
        script="python3 .git/oneshot-scripts/tools.py publish --draft"
    ]

    fail [
        label="Fail run",
        shape=parallelogram,
        stdin_source="stage_failure",
        script="set -eu\nMSG=$(cat || true)\nif [ -z \"$MSG\" ]; then\n  MSG=\"a oneshot stage failed; inspect the failing stage output in the run events and .git/oneshot-state.json\"\nfi\nprintf 'oneshot: %s\\n' \"$MSG\" >&2\nexit 1"
    ]

    start -> setup_helpers -> prepare

    prepare -> diagnose [condition="outcome=succeeded && context.preflight_status!=BLOCKED"]
    prepare -> fail [condition="outcome=succeeded && context.preflight_status=BLOCKED", weight=10]
    prepare -> fail
    diagnose -> baseline [condition="outcome=succeeded && context.preflight_status=READY"]
    diagnose -> fail [condition="outcome=succeeded && context.preflight_status=BLOCKED"]
    diagnose -> fail
    baseline -> implement [condition="outcome=succeeded"]
    baseline -> fail

    implement -> check [condition="outcome=succeeded && context.impl_status=READY"]
    implement -> wait_implement_rate_limit [condition="outcome=failed && context.failure_class contains rate_limit"]
    implement -> salvage [condition="outcome=failed && context.impl_status=BLOCKED"]
    implement -> fail
    wait_implement_rate_limit -> implement [condition="outcome=succeeded"]
    wait_implement_rate_limit -> fail

    check -> review [condition="outcome=succeeded && context.over_limit=false"]
    check -> simplify [condition="outcome=succeeded && context.over_limit=true && context.can_simplify=true"]
    check -> salvage [condition="outcome=succeeded && context.over_limit=true && context.can_simplify=false"]
    check -> fail

    simplify -> check [condition="outcome=succeeded"]
    simplify -> wait_simplify_rate_limit [condition="outcome=failed && context.failure_class contains rate_limit"]
    simplify -> fail
    wait_simplify_rate_limit -> simplify [condition="outcome=succeeded"]
    wait_simplify_rate_limit -> fail

    review -> publish [condition="outcome=succeeded && context.verdict=APPROVED"]
    review -> salvage [condition="outcome=failed && context.failure_class contains network"]
    review -> salvage [condition="outcome=failed && context.failure_class contains environment"]
    review -> salvage [condition="outcome=failed && context.verdict=BLOCKED"]
    review -> rework [condition="outcome=failed && context.verdict=REJECTED"]
    review -> wait_review_rate_limit [condition="outcome=failed && context.failure_class contains rate_limit", weight=10]
    review -> fail
    wait_review_rate_limit -> review [condition="outcome=succeeded"]
    wait_review_rate_limit -> fail

    rework -> implement [condition="outcome=succeeded && context.rework_round <= 2"]
    rework -> salvage [condition="outcome=succeeded && context.rework_round > 2"]
    rework -> fail

    salvage -> exit
    publish -> exit [condition="outcome=succeeded"]
    publish -> fail
    fail -> exit
}
