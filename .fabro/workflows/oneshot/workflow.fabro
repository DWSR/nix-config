digraph Oneshot {
    graph [
        goal="Implement GitHub issue {{ inputs.issue }} as a oneshot change: implement it, keep the Git diff under 1000 lines (simplifying at most twice), review it adversarially, and open a pull request whose body closes the issue.",
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    setup_helpers [
        label="Prepare workflow helpers",
        shape=parallelogram,
        timeout="5m",
        on_failure="exit",
        max_retries=0,
        script="set -eu\nmkdir -p .git/oneshot-scripts\ncp .fabro/workflows/oneshot/scripts/tools.py .git/oneshot-scripts/tools.py\ncp .fabro/workflows/oneshot/scripts/normalize_review.py .git/oneshot-scripts/normalize_review.py\npython3 -c \"import py_compile; py_compile.compile('.git/oneshot-scripts/tools.py', doraise=True); py_compile.compile('.git/oneshot-scripts/normalize_review.py', doraise=True)\""
    ]

    prepare [
        label="Validate labels and prepare",
        shape=parallelogram,
        output_schema="routing",
        goal_gate=true,
        script="test -f .git/oneshot-scripts/tools.py || { echo 'oneshot: helper scripts are missing (fresh sandbox on resume?); start a new run instead of resuming this one' >&2; exit 1; }\npython3 .git/oneshot-scripts/tools.py prepare {{ inputs.issue }}"
    ]

    implement [
        label="Implement issue",
        prompt="@prompts/implement.md",
        output_schema="@schemas/review-result.schema.json",
        output_retries=2,
        max_visits=8,
        max_retries=2,
        retry_policy="patient"
    ]

    normalize_implement [
        label="Normalize implementation result",
        shape=parallelogram,
        output_schema="routing",
        stdin_source="context.output.implement",
        script="python3 .git/oneshot-scripts/normalize_review.py"
    ]

    check [
        label="Check diff size",
        shape=parallelogram,
        output_schema="routing",
        max_visits=6,
        script="python3 .git/oneshot-scripts/tools.py check"
    ]

    simplify [
        label="Simplify change",
        prompt="@prompts/simplify.md",
        output_schema="@schemas/review-result.schema.json",
        output_retries=2,
        max_visits=5,
        max_retries=2,
        retry_policy="patient"
    ]

    normalize_simplify [
        label="Normalize simplification result",
        shape=parallelogram,
        output_schema="routing",
        stdin_source="context.output.simplify",
        script="python3 .git/oneshot-scripts/normalize_review.py"
    ]

    review [
        label="Review change",
        prompt="@prompts/review.md",
        output_schema="@schemas/review-result.schema.json",
        output_retries=2,
        max_visits=8,
        max_retries=2,
        retry_policy="patient"
    ]

    normalize_review [
        label="Normalize review result",
        shape=parallelogram,
        output_schema="routing",
        stdin_source="context.output.review",
        script="python3 .git/oneshot-scripts/normalize_review.py"
    ]

    rework [
        label="Queue rework",
        shape=parallelogram,
        output_schema="routing",
        max_visits=3,
        stdin_source="context.rework_round",
        script="set -eu\nROUND=$(cat 2>/dev/null | tr -d '[:space:]' || true)\ncase \"$ROUND\" in ''|*[!0-9]*) ROUND=0 ;; esac\nROUND=$((ROUND + 1))\nprintf '{\"outcome\":\"succeeded\",\"context_updates\":{\"rework_round\":\"%s\"}}\\n' \"$ROUND\""
    ]

    wait_implement_rate_limit [
        label="Wait for rate limit (implement)",
        shape=parallelogram,
        output_schema="routing",
        timeout="6m",
        max_visits=3,
        script="sleep 300\nprintf '{\"outcome\":\"succeeded\"}\\n'"
    ]

    wait_simplify_rate_limit [
        label="Wait for rate limit (simplify)",
        shape=parallelogram,
        output_schema="routing",
        timeout="6m",
        max_visits=3,
        script="sleep 300\nprintf '{\"outcome\":\"succeeded\"}\\n'"
    ]

    wait_review_rate_limit [
        label="Wait for rate limit (review)",
        shape=parallelogram,
        output_schema="routing",
        timeout="6m",
        max_visits=3,
        script="sleep 300\nprintf '{\"outcome\":\"succeeded\"}\\n'"
    ]

    publish [
        label="Publish pull request",
        shape=parallelogram,
        goal_gate=true,
        script="python3 .git/oneshot-scripts/tools.py publish"
    ]

    fail [
        label="Fail run",
        shape=parallelogram,
        stdin_source="stage_failure",
        script="set -eu\nMSG=$(cat || true)\nif [ -z \"$MSG\" ]; then\n  MSG=\"a oneshot stage failed; inspect the failing stage output in the run events and .git/oneshot-state.json\"\nfi\nprintf 'oneshot: %s\\n' \"$MSG\" >&2\nexit 1"
    ]

    start -> setup_helpers -> prepare

    prepare -> implement [condition="outcome=succeeded"]
    prepare -> fail

    implement -> normalize_implement [condition="outcome=succeeded || outcome=failed"]
    implement -> fail
    normalize_implement -> check [condition="outcome=succeeded && context.impl_status=READY"]
    normalize_implement -> wait_implement_rate_limit [condition="outcome=failed && context.failure_class=rate_limit"]
    normalize_implement -> fail
    wait_implement_rate_limit -> implement [condition="outcome=succeeded"]
    wait_implement_rate_limit -> fail

    check -> review [condition="outcome=succeeded && context.over_limit=false"]
    check -> simplify [condition="outcome=succeeded && context.over_limit=true && context.can_simplify=true"]
    check -> fail

    simplify -> normalize_simplify [condition="outcome=succeeded || outcome=failed"]
    simplify -> fail
    normalize_simplify -> check [condition="outcome=succeeded"]
    normalize_simplify -> wait_simplify_rate_limit [condition="outcome=failed && context.failure_class=rate_limit"]
    normalize_simplify -> fail
    wait_simplify_rate_limit -> simplify [condition="outcome=succeeded"]
    wait_simplify_rate_limit -> fail

    review -> normalize_review [condition="outcome=succeeded || outcome=failed"]
    review -> fail
    normalize_review -> publish [condition="outcome=succeeded && context.verdict=APPROVED && context.failure_class=none"]
    normalize_review -> rework [condition="outcome=failed && context.verdict=REJECTED"]
    normalize_review -> wait_review_rate_limit [condition="outcome=failed && context.failure_class=rate_limit", weight=10]
    normalize_review -> fail [condition="outcome=failed && context.failure_class=network"]
    normalize_review -> fail [condition="outcome=failed && context.failure_class=baseline"]
    normalize_review -> fail [condition="outcome=failed && context.failure_class=environment"]
    normalize_review -> fail [condition="outcome=failed && context.verdict=BLOCKED"]
    normalize_review -> fail
    wait_review_rate_limit -> review [condition="outcome=succeeded"]
    wait_review_rate_limit -> fail

    rework -> implement [condition="outcome=succeeded && context.rework_round <= 2"]
    rework -> fail

    publish -> exit
    fail -> exit
}
