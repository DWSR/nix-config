+
+    /// Clears notifications for all panes in the active tab.
+    /// This handles the case where TabUpdate fires before PaneUpdate,
+    /// so the focused pane data may be stale.
+    pub(crate) fn clear_active_tab_notifications(&mut self) -> bool {
+        let active_tab = match self.tabs.iter().find(|t| t.active) {
+            Some(tab) => tab,
+            None => return false,
+        };
+
+        if !self.tab_name_has_icon(&active_tab.name) {
+            return false;
+        }
+
+        let position = active_tab.position;
+        let pane_ids: Vec<u32> = self.panes.panes
+            .get(&position)
+            .map(|panes| panes.iter().filter(|p| !p.is_plugin).map(|p| p.id).collect())
+            .unwrap_or_default();
+
+        let mut cleared = false;
+        for pane_id in pane_ids {
+            if self.notification_state.remove(&pane_id).is_some() {
+                self.notified_tab_names.remove(&pane_id);
+                cleared = true;
+            }
+        }
+        cleared
+    }
+
