From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DWSR nix-config <noreply@local>
Date: Sun, 9 Aug 2026 09:00:00 -0400
Subject: [PATCH] cavemem: bound Pi full payload privacy

Written for pi-agent-integration task 3.2 against Cavemem v0.2.1,
commit e934e436e0dcb68422475d85385f7f8eb5e449b1, after the repository's
pi-full-v1 payload patch.

Redact the canonical full-mode envelope before its single stringify. Walk
actual objects and arrays, replace complete normalized sensitive-key values,
and scan opaque string leaves only for the finite private, authorization,
provider-token, JWT, private-key PEM, and lexical URL-userinfo rules.

The scanner advances over original input only. Unclosed private and PEM
regions consume through EOF, while embedded JSON, YAML, shell assignments,
environment text, and source code receive no language parsing.
---
 packages/hooks/src/handlers/post-tool-use.ts | 865 ++++++++++++++++++++++-----
 1 file changed, 808 insertions(+), 57 deletions(-)

diff --git a/packages/hooks/src/handlers/post-tool-use.ts b/packages/hooks/src/handlers/post-tool-use.ts
--- a/packages/hooks/src/handlers/post-tool-use.ts
+++ b/packages/hooks/src/handlers/post-tool-use.ts
@@ -19,7 +19,47 @@ const PI_FULL_TRANSPORT_FIELDS = new Set<string>([
   ...PI_FULL_ENVELOPE_FIELDS,
 ]);
 const PI_FULL_OUTPUT_FIELDS = new Set(['content', 'details', 'isError', 'usage']);
 
+const REDACTED_VALUE = '[REDACTED]';
+const SENSITIVE_KEYS = new Set([
+  'accesskey',
+  'accesskeyid',
+  'accesstoken',
+  'apikey',
+  'authtoken',
+  'authorization',
+  'clientsecret',
+  'credential',
+  'credentials',
+  'idtoken',
+  'passphrase',
+  'passwd',
+  'password',
+  'privatekey',
+  'proxyauthorization',
+  'refreshtoken',
+  'secret',
+  'token',
+]);
+const PROVIDER_TOKEN_RULES = [
+  { prefix: 'ghp_', alphabet: 'alnum', minimum: 20 },
+  { prefix: 'gho_', alphabet: 'alnum', minimum: 20 },
+  { prefix: 'ghu_', alphabet: 'alnum', minimum: 20 },
+  { prefix: 'ghs_', alphabet: 'alnum', minimum: 20 },
+  { prefix: 'ghr_', alphabet: 'alnum', minimum: 20 },
+  { prefix: 'github_pat_', alphabet: 'alnum-underscore', minimum: 20 },
+  { prefix: 'shpat_', alphabet: 'alnum', minimum: 20 },
+  { prefix: 'xoxb-', alphabet: 'alnum-hyphen', minimum: 20 },
+  { prefix: 'xoxa-', alphabet: 'alnum-hyphen', minimum: 20 },
+  { prefix: 'xoxp-', alphabet: 'alnum-hyphen', minimum: 20 },
+  { prefix: 'xoxr-', alphabet: 'alnum-hyphen', minimum: 20 },
+  { prefix: 'xoxs-', alphabet: 'alnum-hyphen', minimum: 20 },
+  { prefix: 'glpat-', alphabet: 'alnum-underscore-hyphen', minimum: 20 },
+  { prefix: 'sk-proj-', alphabet: 'alnum-underscore-hyphen', minimum: 20 },
+  { prefix: 'sk-', alphabet: 'alnum-underscore-hyphen', minimum: 20 },
+] as const;
+type ProviderAlphabet = (typeof PROVIDER_TOKEN_RULES)[number]['alphabet'];
+
 export async function postToolUse(
   store: MemoryStore,
   input: HookInput,
@@ -26,16 +66,16 @@ export async function postToolUse(
   captureMode?: CaptureMode,
 ): Promise<void> {
   if (captureMode === 'pi-full-v1') {
-    const content = serializePiFullToolObservationV1(input);
+    const observation = serializePiFullToolObservationV1(input);
     store.addUncompressedObservation({
       session_id: input.session_id,
       kind: 'tool_use',
-      content,
+      content: observation.content,
       metadata: {
-        tool: input.toolName,
+        tool: observation.toolName,
         captureMode,
         schemaVersion: 1,
-        toolCallId: input.toolCallId,
+        toolCallId: observation.toolCallId,
       },
     });
     return;
@@ -58,7 +98,7 @@ export async function postToolUse(
     metadata: { tool },
   });
 }
 
-function serializePiFullToolObservationV1(input: HookInput): string {
+function serializePiFullToolObservationV1(input: HookInput): SerializedPiFullToolObservationV1 {
   assertOnlyFields(input, PI_FULL_TRANSPORT_FIELDS, 'envelope');
   if (typeof input.session_id !== 'string' || !input.session_id.trim()) {
@@ -114,28 +154,723 @@ function serializePiFullToolObservationV1(input: HookInput): string {
       ...(usage !== undefined ? { usage: usage as Record<string, number> } : {}),
     },
   };
-  return JSON.stringify(envelope);
+  assertPiFullUsagePrivacy(envelope.output.usage);
+  const redactedEnvelope = redactPiFullValue(envelope);
+  assertRedactedPiFullToolObservationV1(redactedEnvelope);
+  let content: string | undefined;
+  try {
+    content = JSON.stringify(redactedEnvelope);
+  } catch {
+    throw new Error('pi-full-v1 privacy stringify rule failed at envelope');
+  }
+  if (content === undefined) {
+    throw new Error('pi-full-v1 privacy stringify rule failed at envelope');
+  }
+  return {
+    content,
+    toolCallId: redactedEnvelope.toolCallId,
+    toolName: redactedEnvelope.toolName,
+  };
 }
 
+interface SerializedPiFullToolObservationV1 {
+  readonly content: string;
+  readonly toolCallId: string;
+  readonly toolName: string;
+}
+
+type CanonicalPrivacyLocation =
+  | 'envelope'
+  | 'schemaVersion'
+  | 'toolCallId'
+  | 'toolName'
+  | 'input'
+  | 'output'
+  | 'output.content'
+  | 'output.details'
+  | 'output.isError'
+  | 'output.usage';
+
+function assertPiFullUsagePrivacy(
+  usage: Readonly<Record<string, unknown>> | undefined,
+): void {
+  if (usage === undefined) return;
+  for (const key of Object.getOwnPropertyNames(usage)) {
+    if (SENSITIVE_KEYS.has(normalizeStructuredKey(key))) {
+      throw new Error('pi-full-v1 privacy usage rule failed at output.usage');
+    }
+  }
+}
+
+function assertRedactedPiFullToolObservationV1(
+  value: unknown,
+): asserts value is PiFullToolObservationV1 {
+  const envelope = requireCanonicalRecord(
+    value,
+    PI_FULL_ENVELOPE_FIELDS,
+    PI_FULL_ENVELOPE_FIELDS,
+    'envelope',
+  );
+  if (envelope.schemaVersion !== 1) throw canonicalPrivacyError('schemaVersion');
+  if (typeof envelope.toolCallId !== 'string' || !envelope.toolCallId.trim()) {
+    throw canonicalPrivacyError('toolCallId');
+  }
+  if (typeof envelope.toolName !== 'string' || !envelope.toolName.trim()) {
+    throw canonicalPrivacyError('toolName');
+  }
+  assertRedactedJsonValue(envelope.input, 'input');
+
+  const output = requireCanonicalRecord(
+    envelope.output,
+    ['content', 'details', 'isError', 'usage'],
+    ['content', 'details', 'isError'],
+    'output',
+  );
+  assertRedactedJsonValue(output.content, 'output.content');
+  assertRedactedJsonValue(output.details, 'output.details');
+  if (typeof output.isError !== 'boolean') {
+    throw canonicalPrivacyError('output.isError');
+  }
+  if (Object.hasOwn(output, 'usage')) assertRedactedUsage(output.usage);
+}
+
+function requireCanonicalRecord(
+  value: unknown,
+  allowed: readonly string[],
+  required: readonly string[],
+  location: CanonicalPrivacyLocation,
+): Record<string, unknown> {
+  if (!isRecord(value)) throw canonicalPrivacyError(location);
+  const prototype = Object.getPrototypeOf(value);
+  if (
+    (prototype !== Object.prototype && prototype !== null) ||
+    Object.getOwnPropertySymbols(value).length > 0
+  ) {
+    throw canonicalPrivacyError(location);
+  }
+  for (const property of Object.getOwnPropertyNames(value)) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, property);
+    if (
+      !allowed.includes(property) ||
+      !descriptor?.enumerable ||
+      !Object.hasOwn(descriptor, 'value')
+    ) {
+      throw canonicalPrivacyError(location);
+    }
+  }
+  for (const property of required) {
+    if (!Object.hasOwn(value, property)) throw canonicalPrivacyError(location);
+  }
+  return value;
+}
+
+function assertRedactedUsage(value: unknown): void {
+  if (!isRecord(value)) throw canonicalPrivacyError('output.usage');
+  const prototype = Object.getPrototypeOf(value);
+  if (
+    (prototype !== Object.prototype && prototype !== null) ||
+    Object.getOwnPropertySymbols(value).length > 0
+  ) {
+    throw canonicalPrivacyError('output.usage');
+  }
+  assertPiFullUsagePrivacy(value);
+  for (const property of Object.getOwnPropertyNames(value)) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, property);
+    if (
+      !descriptor?.enumerable ||
+      !Object.hasOwn(descriptor, 'value') ||
+      typeof descriptor.value !== 'number' ||
+      !Number.isFinite(descriptor.value)
+    ) {
+      throw canonicalPrivacyError('output.usage');
+    }
+  }
+}
+
+function assertRedactedJsonValue(value: unknown, location: CanonicalPrivacyLocation): void {
+  try {
+    assertJsonSerializable(value, location);
+  } catch {
+    throw canonicalPrivacyError(location);
+  }
+}
+
+function canonicalPrivacyError(location: CanonicalPrivacyLocation): Error {
+  return new Error(`pi-full-v1 privacy canonical rule failed at ${location}`);
+}
+
+type RedactionContainer = unknown[] | Record<string, unknown>;
+
+interface RedactionFrame {
+  readonly source: RedactionContainer;
+  readonly target: RedactionContainer;
+  readonly depth: number;
+}
+
+function redactPiFullValue(value: unknown): unknown {
+  if (typeof value === 'string') return redactPiFullString(value);
+  if (!Array.isArray(value) && !isRecord(value)) return value;
+
+  const root: RedactionContainer = Array.isArray(value)
+    ? new Array<unknown>(value.length)
+    : createRedactionObject(value);
+  const pending: RedactionFrame[] = [{ source: value, target: root, depth: 0 }];
+
+  const assign = (
+    target: RedactionContainer,
+    property: string | number,
+    nested: unknown,
+    depth: number,
+    sensitive: boolean,
+  ): void => {
+    let next: unknown;
+    if (sensitive) {
+      next = REDACTED_VALUE;
+    } else if (typeof nested === 'string') {
+      next = redactPiFullString(nested);
+    } else if (Array.isArray(nested)) {
+      next = new Array<unknown>(nested.length);
+      pending.push({ source: nested, target: next, depth });
+    } else if (isRecord(nested)) {
+      next = createRedactionObject(nested);
+      pending.push({ source: nested, target: next, depth });
+    } else {
+      next = nested;
+    }
+    Object.defineProperty(target, property, {
+      configurable: true,
+      enumerable: true,
+      value: next,
+      writable: true,
+    });
+  };
+
+  while (pending.length > 0) {
+    const frame = pending.pop()!;
+    if (Array.isArray(frame.source)) {
+      for (let index = 0; index < frame.source.length; index += 1) {
+        const descriptor = Object.getOwnPropertyDescriptor(frame.source, String(index));
+        if (!descriptor?.enumerable || !Object.hasOwn(descriptor, 'value')) {
+          throw structuredPrivacyError('array', frame.depth, index);
+        }
+        assign(frame.target, index, descriptor.value, frame.depth + 1, false);
+      }
+      continue;
+    }
+
+    let ordinal = 0;
+    for (const property of Object.getOwnPropertyNames(frame.source)) {
+      const descriptor = Object.getOwnPropertyDescriptor(frame.source, property);
+      if (!descriptor?.enumerable) continue;
+      ordinal += 1;
+      if (!Object.hasOwn(descriptor, 'value')) {
+        throw structuredPrivacyError('object', frame.depth, ordinal - 1);
+      }
+      assign(
+        frame.target,
+        property,
+        descriptor.value,
+        frame.depth + 1,
+        SENSITIVE_KEYS.has(normalizeStructuredKey(property)),
+      );
+    }
+  }
+
+  return root;
+}
+
+function createRedactionObject(source: Record<string, unknown>): Record<string, unknown> {
+  return Object.getPrototypeOf(source) === null ? Object.create(null) : {};
+}
+
+function structuredPrivacyError(kind: 'array' | 'object', depth: number, ordinal: number): Error {
+  return new Error(`pi-full-v1 privacy structured rule failed at ${kind}[${ordinal}] depth ${depth}`);
+}
+
+function normalizeStructuredKey(key: string): string {
+  let normalized = '';
+  for (let index = 0; index < key.length; index += 1) {
+    const code = key.charCodeAt(index);
+    if (
+      code === 0x20 ||
+      (code >= 0x09 && code <= 0x0d) ||
+      code === 0x2e ||
+      code === 0x2d ||
+      code === 0x5f
+    ) {
+      continue;
+    }
+    normalized += code >= 0x41 && code <= 0x5a ? String.fromCharCode(code + 0x20) : key[index];
+  }
+  return normalized;
+}
+
+function redactPiFullString(input: string): string {
+  if (isCompleteAuthorization(input)) return REDACTED_VALUE;
+
+  let cursor = 0;
+  let emitted = 0;
+  let chunks: string[] | undefined;
+
+  const replace = (start: number, end: number, replacement: string): void => {
+    chunks ??= [];
+    chunks.push(input.slice(emitted, start), replacement);
+    emitted = end;
+    cursor = end;
+  };
+
+  while (cursor < input.length) {
+    const privateEnd = matchPrivateRegion(input, cursor);
+    if (privateEnd !== undefined) {
+      replace(cursor, privateEnd, '');
+      continue;
+    }
+
+    const pemEnd = matchPrivatePem(input, cursor);
+    if (pemEnd !== undefined) {
+      replace(cursor, pemEnd, REDACTED_VALUE);
+      continue;
+    }
+
+    const userinfo = matchUrlUserinfo(input, cursor);
+    if (userinfo !== undefined) {
+      replace(userinfo.start, userinfo.end, REDACTED_VALUE);
+      continue;
+    }
+
+    const providerEnd = matchProviderToken(input, cursor);
+    if (providerEnd !== undefined) {
+      replace(cursor, providerEnd, REDACTED_VALUE);
+      continue;
+    }
+
+    const jwtEnd = matchJwt(input, cursor);
+    if (jwtEnd !== undefined) {
+      replace(cursor, jwtEnd, REDACTED_VALUE);
+      continue;
+    }
+
+    cursor += 1;
+  }
+
+  if (chunks === undefined) return input;
+  chunks.push(input.slice(emitted));
+  return chunks.join('');
+}
+
+function isCompleteAuthorization(input: string): boolean {
+  const trimmed = input.trim();
+  const schemeLength = startsWithAsciiInsensitive(trimmed, 0, 'basic')
+    ? 5
+    : startsWithAsciiInsensitive(trimmed, 0, 'bearer')
+      ? 6
+      : 0;
+  if (schemeLength === 0 || !isAsciiWhitespace(trimmed.charCodeAt(schemeLength))) return false;
+
+  let cursor = schemeLength;
+  while (cursor < trimmed.length && isAsciiWhitespace(trimmed.charCodeAt(cursor))) cursor += 1;
+  if (cursor === trimmed.length) return false;
+  for (; cursor < trimmed.length; cursor += 1) {
+    if (isAsciiWhitespace(trimmed.charCodeAt(cursor))) return false;
+  }
+  return true;
+}
+
+function matchPrivateRegion(input: string, start: number): number | undefined {
+  const openPrefix = '<private';
+  if (!startsWithAsciiInsensitive(input, start, openPrefix)) return undefined;
+  const openSuffix = input[start + openPrefix.length];
+  if (openSuffix !== '>') {
+    return openSuffix === undefined || isAsciiWhitespace(openSuffix.charCodeAt(0))
+      ? input.length
+      : undefined;
+  }
+
+  const opener = '<private>';
+  const closePrefix = '</private';
+  const closer = '</private>';
+  let cursor = start + opener.length;
+  let depth = 1;
+  while (cursor < input.length) {
+    if (startsWithAsciiInsensitive(input, cursor, opener)) {
+      depth += 1;
+      cursor += opener.length;
+      continue;
+    }
+    if (startsWithAsciiInsensitive(input, cursor, openPrefix)) {
+      const suffix = input[cursor + openPrefix.length];
+      if (suffix === undefined || isAsciiWhitespace(suffix.charCodeAt(0))) return input.length;
+    }
+    if (startsWithAsciiInsensitive(input, cursor, closer)) {
+      depth -= 1;
+      cursor += closer.length;
+      if (depth === 0) return cursor;
+      continue;
+    }
+    if (startsWithAsciiInsensitive(input, cursor, closePrefix)) {
+      const suffix = input[cursor + closePrefix.length];
+      if (suffix === undefined || isAsciiWhitespace(suffix.charCodeAt(0))) return input.length;
+    }
+    cursor += 1;
+  }
+  return input.length;
+}
+
+interface PrivatePemBoundary {
+  readonly canonical: boolean;
+  readonly end: number;
+  readonly label: string;
+}
+
+function matchPrivatePem(input: string, start: number): number | undefined {
+  if (start > 0 && input[start - 1] !== '\n' && input[start - 1] !== '\r') return undefined;
+  const opener = matchPrivatePemBoundary(input, start, 'BEGIN');
+  if (opener === undefined) return undefined;
+  if (!opener.canonical) return input.length;
+
+  let lineStart = nextPemLineStart(input, opener.end);
+  while (lineStart < input.length) {
+    if (matchPrivatePemBoundary(input, lineStart, 'BEGIN') !== undefined) {
+      return input.length;
+    }
+    const closer = matchPrivatePemBoundary(input, lineStart, 'END');
+    if (closer !== undefined) {
+      return closer.canonical && closer.label === opener.label ? closer.end : input.length;
+    }
+    lineStart = nextPemLineStart(input, lineStart);
+  }
+  return input.length;
+}
+
+function matchPrivatePemBoundary(
+  input: string,
+  start: number,
+  kind: 'BEGIN' | 'END',
+): PrivatePemBoundary | undefined {
+  const prefix = `-----${kind}`;
+  if (!startsWithAsciiInsensitive(input, start, prefix)) return undefined;
+
+  let cursor = start + prefix.length;
+  while (cursor < input.length && isPemSpacing(input.charCodeAt(cursor))) cursor += 1;
+  const labelStart = cursor;
+  while (
+    cursor < input.length &&
+    cursor - labelStart <= 64 &&
+    input[cursor] !== '-' &&
+    input[cursor] !== '\n' &&
+    input[cursor] !== '\r' &&
+    isPemLabelCharacter(input.charCodeAt(cursor))
+  ) {
+    cursor += 1;
+  }
+  if (cursor === labelStart || cursor - labelStart > 64) return undefined;
+
+  const label = normalizePemLabel(input.slice(labelStart, cursor));
+  if (!isPrivatePemLabel(label)) return undefined;
+  const boundary = `-----${kind} ${label}-----`;
+  const end = start + boundary.length;
+  return {
+    canonical:
+      input.slice(start, end) === boundary &&
+      (end === input.length || input[end] === '\n' || input[end] === '\r'),
+    end,
+    label,
+  };
+}
+
+function isPrivatePemLabel(label: string): boolean {
+  return label === 'PRIVATE KEY' || label.endsWith(' PRIVATE KEY');
+}
+
+function nextPemLineStart(input: string, start: number): number {
+  for (let cursor = start; cursor < input.length; cursor += 1) {
+    if (input[cursor] === '\n') return cursor + 1;
+    if (input[cursor] === '\r') {
+      return input[cursor + 1] === '\n' ? cursor + 2 : cursor + 1;
+    }
+  }
+  return input.length;
+}
+
+function isPemLabelCharacter(code: number): boolean {
+  return isPemSpacing(code) || isAsciiAlphaNumeric(code);
+}
+
+function isPemSpacing(code: number): boolean {
+  return code === 0x20 || code === 0x09;
+}
+
+function normalizePemLabel(label: string): string {
+  let normalized = '';
+  let pendingSpace = false;
+  for (let index = 0; index < label.length; index += 1) {
+    const code = label.charCodeAt(index);
+    if (isPemSpacing(code)) {
+      pendingSpace = normalized.length > 0;
+      continue;
+    }
+    if (!isAsciiAlphaNumeric(code)) return '';
+    if (pendingSpace) normalized += ' ';
+    normalized += String.fromCharCode(code >= 0x61 && code <= 0x7a ? code - 0x20 : code);
+    pendingSpace = false;
+  }
+  return normalized;
+}
+
+function matchProviderToken(input: string, start: number): number | undefined {
+  if (input.startsWith('AKIA', start)) {
+    const end = start + 20;
+    if (end <= input.length) {
+      for (let cursor = start + 4; cursor < end; cursor += 1) {
+        const code = input.charCodeAt(cursor);
+        if (!isAsciiDigit(code) && !(code >= 0x41 && code <= 0x5a)) return undefined;
+      }
+      return end;
+    }
+  }
+
+  for (const rule of PROVIDER_TOKEN_RULES) {
+    if (!input.startsWith(rule.prefix, start)) continue;
+    let cursor = start + rule.prefix.length;
+    while (cursor < input.length && providerAlphabetContains(rule.alphabet, input.charCodeAt(cursor))) {
+      cursor += 1;
+    }
+    if (cursor - start - rule.prefix.length >= rule.minimum) return cursor;
+  }
+  return undefined;
+}
+
+function providerAlphabetContains(alphabet: ProviderAlphabet, code: number): boolean {
+  if (isAsciiAlphaNumeric(code)) return true;
+  if (code === 0x5f) return alphabet !== 'alnum' && alphabet !== 'alnum-hyphen';
+  if (code === 0x2d) return alphabet === 'alnum-hyphen' || alphabet === 'alnum-underscore-hyphen';
+  return false;
+}
+
+function matchJwt(input: string, start: number): number | undefined {
+  if (!input.startsWith('eyJ', start)) return undefined;
+  if (start > 0 && (isBase64Url(input.charCodeAt(start - 1)) || input[start - 1] === '.')) {
+    return undefined;
+  }
+
+  let cursor = start;
+  while (cursor < input.length && isBase64Url(input.charCodeAt(cursor))) cursor += 1;
+  if (cursor - start < 4 || input[cursor] !== '.') return undefined;
+
+  const payloadStart = ++cursor;
+  while (cursor < input.length && isBase64Url(input.charCodeAt(cursor))) cursor += 1;
+  if (cursor === payloadStart || input[cursor] !== '.') return undefined;
+
+  const signatureStart = ++cursor;
+  while (cursor < input.length && isBase64Url(input.charCodeAt(cursor))) cursor += 1;
+  if (cursor === signatureStart) return undefined;
+  if (cursor < input.length && (isBase64Url(input.charCodeAt(cursor)) || input[cursor] === '.')) {
+    return undefined;
+  }
+  return cursor;
+}
+
+function matchUrlUserinfo(
+  input: string,
+  start: number,
+): { start: number; end: number } | undefined {
+  if (!isUrlLexicalBoundary(input, start) || !isAsciiAlpha(input.charCodeAt(start))) {
+    return undefined;
+  }
+
+  let cursor = start + 1;
+  while (cursor < input.length && isSchemeCharacter(input.charCodeAt(cursor))) cursor += 1;
+  if (input.slice(cursor, cursor + 3) !== '://') return undefined;
+
+  const authorityStart = cursor + 3;
+  let authorityEnd = authorityStart;
+  let bracketDepth = 0;
+  while (authorityEnd < input.length) {
+    const character = input[authorityEnd];
+    if (character === '[') {
+      bracketDepth += 1;
+      authorityEnd += 1;
+      continue;
+    }
+    if (character === ']') {
+      if (bracketDepth === 0) break;
+      bracketDepth -= 1;
+      authorityEnd += 1;
+      continue;
+    }
+    if (isAuthorityDelimiter(character)) break;
+    authorityEnd += 1;
+  }
+  if (authorityEnd === authorityStart) return undefined;
+
+  let separator = -1;
+  for (cursor = authorityStart; cursor < authorityEnd; cursor += 1) {
+    if (input[cursor] === '@') separator = cursor;
+  }
+  if (separator <= authorityStart || separator + 1 >= authorityEnd) return undefined;
+  if (!isValidAuthorityHost(input.slice(separator + 1, authorityEnd))) return undefined;
+  return { start: authorityStart, end: separator };
+}
+
+function isUrlLexicalBoundary(input: string, start: number): boolean {
+  if (start === 0) return true;
+  const previous = input[start - 1];
+  if (previous === '[') {
+    if (start === 1) return true;
+    const beforeBracket = input[start - 2];
+    return (
+      isAsciiWhitespace(beforeBracket.charCodeAt(0)) ||
+      beforeBracket === '(' ||
+      beforeBracket === '[' ||
+      beforeBracket === '{' ||
+      beforeBracket === '<'
