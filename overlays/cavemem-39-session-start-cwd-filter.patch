+    const params: unknown[] = hasCwd
+      ? [sanitizeMatch(query), cwd, limit]
+      : [sanitizeMatch(query), limit];
+    const rows = this.db.prepare(sql).all(...params) as Array<{
       id: number;
       session_id: string;
       ts: number;
