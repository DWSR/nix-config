+function readWorkerReceipt(port: number): WorkerReceipt | null {
+  try {
+    const contents = readFileSync(pidFile(), 'utf8');
+    const value = JSON.parse(contents) as unknown;
+    if (typeof value !== 'object' || value === null || Array.isArray(value)) return null;
+    const receipt = value as Partial<WorkerReceipt> & Record<string, unknown>;
+    if (
+      Object.keys(receipt).sort().join(',') !== 'nonce,pid,port' ||
+      !Number.isSafeInteger(receipt.pid) ||
+      Number(receipt.pid) <= 0 ||
+      typeof receipt.nonce !== 'string' ||
+      !/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(
+        receipt.nonce,
+      ) ||
+      receipt.port !== port
+    ) {
+      return null;
+    }
+    return { nonce: receipt.nonce, pid: Number(receipt.pid), port };
+  } catch {
+    return null;
+  }
+}
+
+export async function readyWorkerOwner(): Promise<WorkerOwner | null> {
+  const settings = loadSettings();
+  const receipt = readWorkerReceipt(settings.workerPort);
+  if (receipt === null) return null;
+  try {
+    const response = await fetch(`http://127.0.0.1:${settings.workerPort}/healthz`, {
+      signal: AbortSignal.timeout(WORKER_PROBE_TIMEOUT_MS),
+    });
+    const pidHeader = response.headers.get(WORKER_PID_HEADER);
+    const nonceHeader = response.headers.get(WORKER_NONCE_HEADER);
+    await response.body?.cancel();
+    if (
+      response.status !== 200 ||
+      pidHeader !== String(receipt.pid) ||
+      nonceHeader !== receipt.nonce
+    ) {
+      return null;
+    }
+    return isAlive(receipt.pid) ? receipt : null;
+  } catch {
+    return null;
+  }
+}
+
+function portAcceptsConnections(port: number): Promise<boolean> {
+  return new Promise((resolve) => {
+    const socket = connect({ host: '127.0.0.1', port });
+    let settled = false;
+    const finish = (open: boolean) => {
+      if (settled) return;
+      settled = true;
+      socket.destroy();
+      resolve(open);
+    };
+    socket.setTimeout(250, () => finish(false));
+    socket.once('connect', () => finish(true));
+    socket.once('error', () => finish(false));
+  });
+}
+
+async function waitForWorkerQuiescence(
+  owner: WorkerOwner,
+  timeoutMs: number,
+): Promise<boolean> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (!isAlive(owner.pid) && !(await portAcceptsConnections(owner.port))) return true;
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  return !isAlive(owner.pid) && !(await portAcceptsConnections(owner.port));
+}
+
+async function stopVerifiedWorker(owner: WorkerOwner): Promise<void> {
+  try {
+    process.kill(owner.pid, 'SIGTERM');
+  } catch {
+    // Quiescence below distinguishes a completed exit from a failed signal.
+  }
+  if (await waitForWorkerQuiescence(owner, WORKER_STOP_GRACE_MS)) return;
+
+  if (isAlive(owner.pid)) {
+    try {
+      process.kill(owner.pid, 'SIGKILL');
+    } catch {
+      // Quiescence below remains authoritative.
+    }
+  }
+  if (!(await waitForWorkerQuiescence(owner, WORKER_STOP_TIMEOUT_MS))) {
+    throw new Error('worker failed to stop');
+  }
+}
+
+function waitForWorkerReady(child: ChildProcess, pid: number): Promise<void> {
+  return new Promise((resolve, reject) => {
+    let killTimer: ReturnType<typeof setTimeout> | undefined;
+    let settled = false;
+    let terminating = false;
+    let verifying = false;
+    const terminate = () => {
+      if (terminating) return;
+      terminating = true;
+      try {
+        child.kill('SIGTERM');
+      } catch {
+        // The exit or error handler reports the constant startup failure.
+      }
+      killTimer = setTimeout(() => {
+        if (child.exitCode === null && child.signalCode === null) {
+          try {
+            child.kill('SIGKILL');
+          } catch {
+            // The exit or error handler reports the constant startup failure.
+          }
+        }
+      }, WORKER_STOP_GRACE_MS);
+    };
+    const timeout = setTimeout(terminate, WORKER_START_TIMEOUT_MS);
+
+    const cleanup = () => {
+      clearTimeout(timeout);
+      if (killTimer !== undefined) clearTimeout(killTimer);
+      child.off('message', onMessage);
+      child.off('exit', onExit);
+      child.off('error', onError);
+    };
+    const fail = () => {
+      if (settled) return;
+      settled = true;
+      cleanup();
+      reject(new Error('worker failed to start'));
+    };
+    const succeed = () => {
+      if (settled) return;
+      settled = true;
+      cleanup();
+      try {
+        if (child.connected) child.disconnect();
+      } catch {}
+      child.unref();
+      resolve();
+    };
+    const onMessage = (message: unknown) => {
+      if (terminating || verifying || typeof message !== 'object' || message === null) return;
+      const ready = message as {
+        type?: unknown;
+        nonce?: unknown;
+        pid?: unknown;
+        port?: unknown;
+      };
+      if (ready.type !== WORKER_READY_MESSAGE || ready.pid !== pid) return;
+      if (
+        typeof ready.nonce !== 'string' ||
+        !Number.isSafeInteger(ready.port) ||
+        Number(ready.port) <= 0
+      ) {
+        terminate();
+        return;
+      }
+      verifying = true;
+      readyWorkerOwner()
+        .then((owner) => {
+          if (
+            owner?.pid === pid &&
+            owner.nonce === ready.nonce &&
+            owner.port === ready.port &&
+            !terminating
+          ) {
+            succeed();
+          }
+          else terminate();
+        })
+        .catch(terminate);
+    };
+    const onExit = () => fail();
+    const onError = () => fail();
+
+    child.on('message', onMessage);
+    child.once('exit', onExit);
+    child.once('error', onError);
+  });
+}
+
+export async function startWorkerDaemon(): Promise<{ pid: number; started: boolean }> {
+  const running = await readyWorkerOwner();
+  if (running !== null) return { pid: running.pid, started: false };
+
+  // The bound worker performs stale cleanup and publishes readiness. The daemon
+  // parent never mutates the pidfile.
+  const child = spawn(process.execPath, [resolveCliPath(), 'worker', 'run'], {
+    detached: true,
+    stdio: ['ignore', 'ignore', 'ignore', 'ipc'],
+    env: process.env,
+  });
+  const pid = child.pid;
+  if (!pid) throw new Error('worker failed to start');
+  await waitForWorkerReady(child, pid);
+  return { pid, started: true };
+}
+
+export async function stopWorkerDaemon(): Promise<number | null> {
+  const owner = await readyWorkerOwner();
+  if (owner === null) return null;
+  await stopVerifiedWorker(owner);
+  return owner.pid;
+}
+
+export async function restartWorkerDaemon(): Promise<{ pid: number; started: true }> {
+  const owner = await readyWorkerOwner();
+  if (owner !== null) await stopVerifiedWorker(owner);
+  const worker = await startWorkerDaemon();
+  if (!worker.started) throw new Error('worker failed to restart');
+  return worker;
+}
