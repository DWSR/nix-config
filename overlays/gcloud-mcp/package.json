{
  "name": "@google-cloud/gcloud-mcp",
  "version": "0.5.3",
  "type": "module",
  "files": [
    "dist/"
  ],
  "bin": {
    "gcloud-mcp": "./dist/bundle.js"
  },
  "scripts": {
    "build": "tsc --noemit && node build.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "start": "node dist/bundle.js",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "fix": "prettier --write . && eslint . --fix",
    "pretest": "npm run build",
    "posttest": "npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/googleapis/gcloud-mcp.git",
    "directory": "packages/gcloud-mcp"
  },
  "keywords": [
    "gcloud",
    "gcp",
    "google cloud",
    "mcp",
    "mcp server"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/googleapis/gcloud-mcp/issues"
  },
  "homepage": "https://github.com/googleapis/gcloud-mcp#readme",
  "description": "Model Context Protocol (MCP) Server for interacting with GCP APIs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@types/yargs": "^17.0.33",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "ip-address": "10.7.1"
  }
}
