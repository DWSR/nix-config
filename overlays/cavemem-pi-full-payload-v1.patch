   const toolInput = input.tool_input;
   const toolOutput = input.tool_response ?? input.tool_output;
@@ -19,6 +58,128 @@ export async function postToolUse(store: MemoryStore, input: HookInput): Promise<void> {
   });
 }
 
+function serializePiFullToolObservationV1(input: HookInput): string {
+  assertOnlyFields(input, PI_FULL_TRANSPORT_FIELDS, 'envelope');
+  if (typeof input.session_id !== 'string' || !input.session_id.trim()) {
+    throw new Error('pi-full-v1 session_id must be a non-empty string');
+  }
+  if (input.schemaVersion !== 1) {
+    throw new Error('pi-full-v1 schemaVersion must equal 1');
+  }
+  if (typeof input.toolCallId !== 'string' || !input.toolCallId.trim()) {
+    throw new Error('pi-full-v1 toolCallId must be a non-empty string');
+  }
+  if (typeof input.toolName !== 'string' || !input.toolName.trim()) {
+    throw new Error('pi-full-v1 toolName must be a non-empty string');
+  }
+  if (!Object.hasOwn(input, 'input')) {
+    throw new Error('pi-full-v1 input is required');
+  }
+  assertJsonSerializable(input.input, 'input');
+
+  if (!isRecord(input.output)) {
+    throw new Error('pi-full-v1 output must be an object');
+  }
+  assertOnlyFields(input.output, PI_FULL_OUTPUT_FIELDS, 'output');
+  if (!Object.hasOwn(input.output, 'content')) {
+    throw new Error('pi-full-v1 output.content is required');
+  }
+  if (!Object.hasOwn(input.output, 'details')) {
+    throw new Error('pi-full-v1 output.details is required');
+  }
+  if (typeof input.output.isError !== 'boolean') {
+    throw new Error('pi-full-v1 output.isError must be a boolean');
+  }
+  assertJsonSerializable(input.output.content, 'output.content');
+  assertJsonSerializable(input.output.details, 'output.details');
+
+  const usage = input.output.usage;
+  if (
+    usage !== undefined &&
+    (!isRecord(usage) ||
+      !Object.values(usage).every((value) => typeof value === 'number' && Number.isFinite(value)))
+  ) {
+    throw new Error('pi-full-v1 output.usage must contain only finite numbers');
+  }
+
+  const envelope: PiFullToolObservationV1 = {
+    schemaVersion: 1,
+    toolCallId: input.toolCallId,
+    toolName: input.toolName,
+    input: input.input,
+    output: {
+      content: input.output.content,
+      details: input.output.details,
+      isError: input.output.isError,
+      ...(usage !== undefined ? { usage: usage as Record<string, number> } : {}),
+    },
+  };
+  return JSON.stringify(envelope);
+}
+
+function assertOnlyFields(
+  value: object,
+  allowed: ReadonlySet<string>,
+  scope: 'envelope' | 'output',
+): void {
+  const unknown = Object.getOwnPropertyNames(value)
+    .filter((field) => !allowed.has(field))
+    .sort();
+  const symbols = Object.getOwnPropertySymbols(value);
+  if (unknown.length === 0 && symbols.length === 0) return;
+
+  const fields = [
+    ...unknown.map((field) =>
+      /^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(field) ? field : '<invalid>',
+    ),
+    ...symbols.map(() => '<invalid>'),
+  ];
+  const noun = fields.length === 1 ? 'field' : 'fields';
+  const displayed = fields.slice(0, 3).join(', ');
+  const suffix = fields.length > 3 ? ', ...' : '';
+  throw new Error(`pi-full-v1 ${scope} contains unknown ${noun}: ${displayed}${suffix}`);
+}
+
+function assertJsonSerializable(value: unknown, field: string, seen = new Set<object>()): void {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean') return;
+  if (typeof value === 'number') {
+    if (Number.isFinite(value)) return;
+    throw new Error(`pi-full-v1 ${field} must be JSON-serializable`);
+  }
+  if (typeof value !== 'object') {
+    throw new Error(`pi-full-v1 ${field} must be JSON-serializable`);
+  }
+  if (seen.has(value)) {
+    throw new Error(`pi-full-v1 ${field} must be JSON-serializable`);
+  }
+
+  seen.add(value);
+  if (Array.isArray(value)) {
+    for (let index = 0; index < value.length; index += 1) {
+      if (!Object.hasOwn(value, index)) {
+        throw new Error(`pi-full-v1 ${field} must be JSON-serializable`);
+      }
+      assertJsonSerializable(value[index], field, seen);
+    }
+  } else {
+    const prototype = Object.getPrototypeOf(value);
+    if (
+      (prototype !== Object.prototype && prototype !== null) ||
+      Object.getOwnPropertySymbols(value).length > 0
+    ) {
+      throw new Error(`pi-full-v1 ${field} must be JSON-serializable`);
+    }
+    for (const nested of Object.values(value)) {
+      assertJsonSerializable(nested, field, seen);
+    }
+  }
+  seen.delete(value);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
 function stringifyShort(v: unknown): string {
   if (v == null) return '';
   if (typeof v === 'string') return v.length > 500 ? `${v.slice(0, 500)}…` : v;
