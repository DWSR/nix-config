+    store.addUncompressedObservation({
+      session_id: input.session_id,
+      kind: 'tool_use',
+      content,
+      metadata: {
+        tool: input.toolName,
+        captureMode,
+        schemaVersion: 1,
+        toolCallId: input.toolCallId,
+      },
+    });
+    return;
+  }
 
-export async function postToolUse(store: MemoryStore, input: HookInput): Promise<void> {
