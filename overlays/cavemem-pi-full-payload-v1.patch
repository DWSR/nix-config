+const PI_FULL_ENVELOPE_FIELDS = [
+  'schemaVersion',
+  'toolCallId',
+  'toolName',
+  'input',
+  'output',
+] as const;
+// session_id and ide wrap the stored envelope and are never serialized.
+const PI_FULL_TRANSPORT_FIELDS = new Set<string>([
+  'session_id',
+  'ide',
+  ...PI_FULL_ENVELOPE_FIELDS,
+]);
+const PI_FULL_OUTPUT_FIELDS = new Set(['content', 'details', 'isError', 'usage']);
