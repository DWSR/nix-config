+func stackUnstackArgs() map[string]any {
+	return withStackArg(stackArgs("unstack"), "stackNumber", float64(7))
+}
+
+func withStackArg(args map[string]any, name string, value any) map[string]any {
+	copy := make(map[string]any, len(args)+1)
+	for key, existing := range args {
+		copy[key] = existing
+	}
+	copy[name] = value
+	return copy
+}
+
+func mapKeys(values map[string]any) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	return keys
+}
