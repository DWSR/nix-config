+	result := callStackToolWithDeps(t, PullRequestStackRead, deps, withStackArg(stackArgs("get"), "stackNumber", float64(999)))
+	require.True(t, result.IsError)
+	assert.Zero(t, visibilityRequests)
+	if result.Meta != nil {
+		_, hasIFC := result.Meta["ifc"]
+		assert.False(t, hasIFC)
+	}
