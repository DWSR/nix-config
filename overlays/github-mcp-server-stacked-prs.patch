@@ -0,0 +1,492 @@
+package github
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+
+	ghErrors "github.com/github/github-mcp-server/pkg/errors"
+	"github.com/github/github-mcp-server/pkg/ifc"
+	"github.com/github/github-mcp-server/pkg/inventory"
+	"github.com/github/github-mcp-server/pkg/scopes"
+	"github.com/github/github-mcp-server/pkg/translations"
+	"github.com/github/github-mcp-server/pkg/utils"
+	githubapi "github.com/google/go-github/v89/github"
+	"github.com/google/jsonschema-go/jsonschema"
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+const (
+	pullRequestStacksAPIVersion = "2026-03-10"
+	pullRequestStacksAccept     = "application/vnd.github+json"
+)
+
+// PullRequestStack is GitHub's native stacked pull request response model.
+type PullRequestStack struct {
+	ID           int64                         `json:"id"`
+	Number       int                           `json:"number"`
+	NodeID       string                        `json:"node_id"`
+	URL          string                        `json:"url"`
+	Base         PullRequestStackBase          `json:"base"`
+	Open         bool                          `json:"open"`
+	CreatedAt    string                        `json:"created_at"`
+	PullRequests []PullRequestStackPullRequest `json:"pull_requests"`
+}
+
+// PullRequestStackBase identifies the branch beneath the bottom pull request.
+type PullRequestStackBase struct {
+	Ref string `json:"ref"`
+	SHA string `json:"sha,omitempty"`
+}
+
+// PullRequestStackPullRequest describes one ordered pull request in a stack.
+type PullRequestStackPullRequest struct {
+	Number   int                             `json:"number"`
+	State    string                          `json:"state"`
+	Draft    bool                            `json:"draft"`
+	MergedAt *string                         `json:"merged_at"`
+	Head     PullRequestStackPullRequestHead `json:"head"`
+}
+
+// PullRequestStackPullRequestHead identifies a stack pull request's head.
+type PullRequestStackPullRequestHead struct {
+	Ref string `json:"ref"`
+	SHA string `json:"sha"`
+}
+
+type pullRequestStackMutation struct {
+	PullRequests []int `json:"pull_requests"`
+}
+
+type pullRequestStackUnstackResult struct {
+	Dissolved bool              `json:"dissolved"`
+	Stack     *PullRequestStack `json:"stack,omitempty"`
+}
+
+// PullRequestStackRead creates a tool for listing and getting native pull request stacks.
+func PullRequestStackRead(t translations.TranslationHelperFunc) inventory.ServerTool {
+	schema := &jsonschema.Schema{
+		Type: "object",
+		Properties: map[string]*jsonschema.Schema{
+			"method": {
+				Type:        "string",
+				Description: "Stack read operation: list stacks in a repository, or get one stack by stackNumber.",
+				Enum:        []any{"list", "get"},
+			},
+			"owner": {
+				Type:        "string",
+				Description: "Repository owner",
+			},
+			"repo": {
+				Type:        "string",
+				Description: "Repository name",
+			},
+			"stackNumber": {
+				Type:        "number",
+				Description: "Stack number. Required for get.",
+				Minimum:     jsonschema.Ptr(1.0),
+			},
+			"pullNumber": {
+				Type:        "number",
+				Description: "Filter list results to the stack containing this pull request.",
+				Minimum:     jsonschema.Ptr(1.0),
+			},
+			"page": {
+				Type:        "number",
+				Description: "Page number for list pagination (min 1).",
+				Minimum:     jsonschema.Ptr(1.0),
+			},
+			"perPage": {
+				Type:        "number",
+				Description: "Results per page for list pagination (min 1, max 100).",
+				Minimum:     jsonschema.Ptr(1.0),
+				Maximum:     jsonschema.Ptr(100.0),
+			},
+		},
+		Required:             []string{"method", "owner", "repo"},
+		AdditionalProperties: &jsonschema.Schema{Not: &jsonschema.Schema{}},
+	}
+
+	return NewTool(
+		ToolsetMetadataPullRequests,
+		mcp.Tool{
+			Name:        "pull_request_stack_read",
+			Description: t("TOOL_PULL_REQUEST_STACK_READ_DESCRIPTION", "List native pull request stacks in a repository or get one stack by number."),
+			Annotations: &mcp.ToolAnnotations{
+				Title:        t("TOOL_PULL_REQUEST_STACK_READ_USER_TITLE", "Read pull request stacks"),
+				ReadOnlyHint: true,
+			},
+			InputSchema: schema,
+		},
+		scopes.PublicRead(scopes.Repo),
+		func(ctx context.Context, deps ToolDependencies, _ *mcp.CallToolRequest, args map[string]any) (*mcp.CallToolResult, any, error) {
+			method, err := RequiredParam[string](args, "method")
+			if err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+
+			var allowed []string
+			switch method {
+			case "list":
+				allowed = []string{"method", "owner", "repo", "pullNumber", "page", "perPage"}
+			case "get":
+				allowed = []string{"method", "owner", "repo", "stackNumber"}
+			default:
+				return utils.NewToolResultError(fmt.Sprintf("unknown method: %s", method)), nil, nil
+			}
+			if err := rejectStackArguments(args, method, allowed...); err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+
+			owner, err := RequiredParam[string](args, "owner")
+			if err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+			repo, err := RequiredParam[string](args, "repo")
+			if err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+			client, err := deps.GetClient(ctx)
+			if err != nil {
+				return utils.NewToolResultErrorFromErr("failed to get GitHub client", err), nil, nil
+			}
+
+			var result *mcp.CallToolResult
+			switch method {
+			case "list":
+				result = listPullRequestStacks(ctx, client, owner, repo, args)
+			case "get":
+				stackNumber, err := requiredPositiveStackInt(args, "stackNumber")
+				if err != nil {
+					return utils.NewToolResultError(err.Error()), nil, nil
+				}
+				result = getPullRequestStack(ctx, client, owner, repo, stackNumber)
+			default:
+				panic("validated pull request stack read method became unreachable")
+			}
+			result = attachRepoVisibilityIFCLabelLazy(ctx, deps, owner, repo, result, ifc.LabelRepoMetadata)
+			return result, nil, nil
+		},
+	)
+}
+
+// PullRequestStackWrite creates a tool for creating, extending, and unstacking native stacks.
+func PullRequestStackWrite(t translations.TranslationHelperFunc) inventory.ServerTool {
+	schema := &jsonschema.Schema{
+		Type: "object",
+		Properties: map[string]*jsonschema.Schema{
+			"method": {
+				Type:        "string",
+				Description: "Stack write operation: create, add pull requests to the top, or unstack eligible pull requests.",
+				Enum:        []any{"create", "add", "unstack"},
+			},
+			"owner": {
+				Type:        "string",
+				Description: "Repository owner",
+			},
+			"repo": {
+				Type:        "string",
+				Description: "Repository name",
+			},
+			"stackNumber": {
+				Type:        "number",
+				Description: "Stack number. Required for add and unstack.",
+				Minimum:     jsonschema.Ptr(1.0),
+			},
+			"pullNumbers": {
+				Type:        "array",
+				Description: "Pull request numbers ordered from the bottom of the new segment to the top. Create requires at least two; add requires at least one.",
+				Items: &jsonschema.Schema{
+					Type:    "number",
+					Minimum: jsonschema.Ptr(1.0),
+				},
+				MinItems: jsonschema.Ptr(1),
+			},
+		},
+		Required:             []string{"method", "owner", "repo"},
+		AdditionalProperties: &jsonschema.Schema{Not: &jsonschema.Schema{}},
+	}
+
+	return NewTool(
+		ToolsetMetadataPullRequests,
+		mcp.Tool{
+			Name:        "pull_request_stack_write",
+			Description: t("TOOL_PULL_REQUEST_STACK_WRITE_DESCRIPTION", "Create a native pull request stack, append pull requests to its top, or remove eligible pull requests from it."),
+			Annotations: &mcp.ToolAnnotations{
+				Title:           t("TOOL_PULL_REQUEST_STACK_WRITE_USER_TITLE", "Manage pull request stacks"),
+				ReadOnlyHint:    false,
+				DestructiveHint: jsonschema.Ptr(true),
+			},
+			InputSchema: schema,
+		},
+		scopes.RequireAll(scopes.Repo),
+		func(ctx context.Context, deps ToolDependencies, _ *mcp.CallToolRequest, args map[string]any) (*mcp.CallToolResult, any, error) {
+			method, err := RequiredParam[string](args, "method")
+			if err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+
+			var allowed []string
+			switch method {
+			case "create":
+				allowed = []string{"method", "owner", "repo", "pullNumbers"}
+			case "add":
+				allowed = []string{"method", "owner", "repo", "stackNumber", "pullNumbers"}
+			case "unstack":
+				allowed = []string{"method", "owner", "repo", "stackNumber"}
+			default:
+				return utils.NewToolResultError(fmt.Sprintf("unknown method: %s", method)), nil, nil
+			}
+			if err := rejectStackArguments(args, method, allowed...); err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+
+			owner, err := RequiredParam[string](args, "owner")
+			if err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+			repo, err := RequiredParam[string](args, "repo")
+			if err != nil {
+				return utils.NewToolResultError(err.Error()), nil, nil
+			}
+			client, err := deps.GetClient(ctx)
+			if err != nil {
+				return utils.NewToolResultErrorFromErr("failed to get GitHub client", err), nil, nil
+			}
+
+			var result *mcp.CallToolResult
+			switch method {
+			case "create":
+				pullNumbers, err := requiredPositiveStackInts(args, "pullNumbers", 2)
+				if err != nil {
+					return utils.NewToolResultError(err.Error()), nil, nil
+				}
+				result = createPullRequestStack(ctx, client, owner, repo, pullNumbers)
+			case "add":
+				stackNumber, err := requiredPositiveStackInt(args, "stackNumber")
+				if err != nil {
+					return utils.NewToolResultError(err.Error()), nil, nil
+				}
+				pullNumbers, err := requiredPositiveStackInts(args, "pullNumbers", 1)
+				if err != nil {
+					return utils.NewToolResultError(err.Error()), nil, nil
+				}
+				result = addPullRequestsToStack(ctx, client, owner, repo, stackNumber, pullNumbers)
+			case "unstack":
+				stackNumber, err := requiredPositiveStackInt(args, "stackNumber")
+				if err != nil {
+					return utils.NewToolResultError(err.Error()), nil, nil
+				}
+				result = unstackPullRequestStack(ctx, client, owner, repo, stackNumber)
+			default:
+				panic("validated pull request stack write method became unreachable")
+			}
+			result = attachRepoVisibilityIFCLabelLazy(ctx, deps, owner, repo, result, ifc.LabelRepoMetadata)
+			return result, nil, nil
+		},
+	)
+}
+
+func listPullRequestStacks(ctx context.Context, client *githubapi.Client, owner, repo string, args map[string]any) *mcp.CallToolResult {
+	query := url.Values{}
+	for _, parameter := range []struct {
+		mcpName string
+		apiName string
+	}{
+		{mcpName: "pullNumber", apiName: "pull_request"},
+		{mcpName: "page", apiName: "page"},
+		{mcpName: "perPage", apiName: "per_page"},
+	} {
+		value, ok, err := optionalPositiveStackInt(args, parameter.mcpName)
+		if err != nil {
+			return utils.NewToolResultError(err.Error())
+		}
+		if ok {
+			if parameter.mcpName == "perPage" && value > 100 {
+				return utils.NewToolResultError("parameter perPage must be at most 100")
+			}
+			query.Set(parameter.apiName, strconv.Itoa(value))
+		}
+	}
+
+	apiURL := fmt.Sprintf("repos/%s/%s/stacks", owner, repo)
+	if encoded := query.Encode(); encoded != "" {
+		apiURL += "?" + encoded
+	}
+
+	var stacks []PullRequestStack
+	resp, err := doPullRequestStackRequest(ctx, client, http.MethodGet, apiURL, nil, &stacks)
+	if err != nil {
+		return ghErrors.NewGitHubAPIErrorResponse(ctx, "failed to list pull request stacks", resp, err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return unexpectedPullRequestStackStatus("list pull request stacks", resp.StatusCode, http.StatusOK)
+	}
+	return MarshalledTextResult(stacks)
+}
+
+func getPullRequestStack(ctx context.Context, client *githubapi.Client, owner, repo string, stackNumber int) *mcp.CallToolResult {
+	apiURL := fmt.Sprintf("repos/%s/%s/stacks/%d", owner, repo, stackNumber)
+	var stack PullRequestStack
+	resp, err := doPullRequestStackRequest(ctx, client, http.MethodGet, apiURL, nil, &stack)
+	if err != nil {
+		return ghErrors.NewGitHubAPIErrorResponse(ctx, "failed to get pull request stack", resp, err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return unexpectedPullRequestStackStatus("get pull request stack", resp.StatusCode, http.StatusOK)
+	}
+	return MarshalledTextResult(stack)
+}
+
+func createPullRequestStack(ctx context.Context, client *githubapi.Client, owner, repo string, pullNumbers []int) *mcp.CallToolResult {
+	apiURL := fmt.Sprintf("repos/%s/%s/stacks", owner, repo)
+	var stack PullRequestStack
+	resp, err := doPullRequestStackRequest(ctx, client, http.MethodPost, apiURL, pullRequestStackMutation{PullRequests: pullNumbers}, &stack)
+	if err != nil {
+		return ghErrors.NewGitHubAPIErrorResponse(ctx, "failed to create pull request stack", resp, err)
+	}
+	if resp.StatusCode != http.StatusCreated {
+		return unexpectedPullRequestStackStatus("create pull request stack", resp.StatusCode, http.StatusCreated)
+	}
+	return MarshalledTextResult(stack)
+}
+
+func addPullRequestsToStack(ctx context.Context, client *githubapi.Client, owner, repo string, stackNumber int, pullNumbers []int) *mcp.CallToolResult {
+	apiURL := fmt.Sprintf("repos/%s/%s/stacks/%d/add", owner, repo, stackNumber)
+	var stack PullRequestStack
+	resp, err := doPullRequestStackRequest(ctx, client, http.MethodPost, apiURL, pullRequestStackMutation{PullRequests: pullNumbers}, &stack)
+	if err != nil {
+		return ghErrors.NewGitHubAPIErrorResponse(ctx, "failed to add pull requests to stack", resp, err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return unexpectedPullRequestStackStatus("add pull requests to stack", resp.StatusCode, http.StatusOK)
+	}
+	return MarshalledTextResult(stack)
+}
+
+func unstackPullRequestStack(ctx context.Context, client *githubapi.Client, owner, repo string, stackNumber int) *mcp.CallToolResult {
+	apiURL := fmt.Sprintf("repos/%s/%s/stacks/%d/unstack", owner, repo, stackNumber)
+	var stack PullRequestStack
+	resp, err := doPullRequestStackRequest(ctx, client, http.MethodPost, apiURL, nil, &stack)
+	if err != nil {
+		return ghErrors.NewGitHubAPIErrorResponse(ctx, "failed to unstack pull request stack", resp, err)
+	}
+
+	switch resp.StatusCode {
+	case http.StatusNoContent:
+		return MarshalledTextResult(pullRequestStackUnstackResult{Dissolved: true})
+	case http.StatusOK:
+		return MarshalledTextResult(pullRequestStackUnstackResult{Dissolved: false, Stack: &stack})
+	default:
+		return unexpectedPullRequestStackStatus("unstack pull request stack", resp.StatusCode, http.StatusOK, http.StatusNoContent)
+	}
+}
+
+func doPullRequestStackRequest(ctx context.Context, client *githubapi.Client, method, apiURL string, body, out any) (*githubapi.Response, error) {
+	req, err := client.NewRequest(ctx, method, apiURL, body, githubapi.WithVersion(pullRequestStacksAPIVersion))
+	if err != nil {
+		return nil, fmt.Errorf("failed to create request: %w", err)
+	}
+	req.Header.Set("Accept", pullRequestStacksAccept)
+	return client.Do(req, out)
+}
+
+func requiredPositiveStackInt(args map[string]any, name string) (int, error) {
+	raw, ok := args[name]
+	if !ok {
+		return 0, fmt.Errorf("missing required parameter: %s", name)
+	}
+	value, err := stackInt(raw)
+	if err != nil {
+		return 0, fmt.Errorf("parameter %s must be a positive integer: %w", name, err)
+	}
+	if value <= 0 {
+		return 0, fmt.Errorf("parameter %s must be a positive integer", name)
+	}
+	return value, nil
+}
+
+func optionalPositiveStackInt(args map[string]any, name string) (int, bool, error) {
+	if _, ok := args[name]; !ok {
+		return 0, false, nil
+	}
+	value, err := requiredPositiveStackInt(args, name)
+	return value, true, err
+}
+
+func requiredPositiveStackInts(args map[string]any, name string, minimumLength int) ([]int, error) {
+	raw, ok := args[name]
+	if !ok {
+		return nil, fmt.Errorf("missing required parameter: %s", name)
+	}
+
+	var values []any
+	switch value := raw.(type) {
+	case []any:
+		values = value
+	case []float64:
+		values = make([]any, len(value))
+		for i, item := range value {
+			values[i] = item
+		}
+	case []int:
+		result := append([]int(nil), value...)
+		if len(result) < minimumLength {
+			return nil, fmt.Errorf("parameter %s must contain at least %d pull request numbers", name, minimumLength)
+		}
+		for i, item := range result {
+			if item <= 0 {
+				return nil, fmt.Errorf("parameter %s item %d must be a positive integer", name, i)
+			}
+		}
+		return result, nil
+	default:
+		return nil, fmt.Errorf("parameter %s must be an array of positive integers", name)
+	}
+
+	if len(values) < minimumLength {
+		return nil, fmt.Errorf("parameter %s must contain at least %d pull request numbers", name, minimumLength)
+	}
+	result := make([]int, len(values))
+	for i, item := range values {
+		value, err := stackInt(item)
+		if err != nil || value <= 0 {
+			return nil, fmt.Errorf("parameter %s item %d must be a positive integer", name, i)
+		}
+		result[i] = value
+	}
+	return result, nil
+}
+
+func stackInt(value any) (int, error) {
+	if value, ok := value.(int); ok {
+		return value, nil
+	}
+	return toInt(value)
+}
+
+func rejectStackArguments(args map[string]any, method string, allowed ...string) error {
+	allowedSet := make(map[string]struct{}, len(allowed))
+	for _, name := range allowed {
+		allowedSet[name] = struct{}{}
+	}
+	var unexpected []string
+	for name := range args {
+		if _, ok := allowedSet[name]; !ok {
+			unexpected = append(unexpected, name)
+		}
+	}
+	if len(unexpected) == 0 {
+		return nil
+	}
+	sort.Strings(unexpected)
+	return fmt.Errorf("method %s does not accept parameter(s): %s", method, strings.Join(unexpected, ", "))
+}
+
+func unexpectedPullRequestStackStatus(action string, actual int, expected ...int) *mcp.CallToolResult {
+	return utils.NewToolResultError(fmt.Sprintf("failed to %s: unexpected HTTP status %d (expected %v)", action, actual, expected))
+}
