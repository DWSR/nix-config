import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
import {
	normalizePlanModeCompletion,
	PLAN_MODE_COMPLETE_PARAMS,
	PLAN_MODE_COMPLETE_TOOL_NAME,
	planModeCompleted,
	renderPlanModeCompletion,
} from "./completion-tool.js";
import { formatImplementationHandoff } from "./fresh-implementation.js";
import { buildPlanModePrompt } from "./prompt.js";
import {
	answerPlanModeQuestions,
	normalizePlanModeQuestionParams,
	PLAN_MODE_QUESTION_PARAMS,
	PLAN_MODE_QUESTION_TOOL_NAME,
	planModeQuestionCancelled,
} from "./question-tool.js";

type PlanPhase = "normal" | "planning" | "awaiting-approval" | "approved";

interface ManagedPlanState {
	phase: PlanPhase;
	capturedToolNames: string[];
	latestPlan?: string;
}

type SessionEntry = {
	type?: string;
	customType?: string;
	data?: unknown;
};

type RestoredState =
	| { kind: "valid"; state: ManagedPlanState }
	| { kind: "unavailable" | "invalid" };

const STATE_ENTRY_TYPE = "plan-mode-state";
const STATUS_KEY = "plan-mode";
const PLAN_WIDGET_KEY = "plan-mode-plan";
const MANAGED_PLAN_TOOL_NAMES = [
	"read",
	"grep",
	"find",
	"ls",
	PLAN_MODE_QUESTION_TOOL_NAME,
	PLAN_MODE_COMPLETE_TOOL_NAME,
] as const;
const MANAGED_PLAN_TOOL_NAME_SET = new Set<string>(MANAGED_PLAN_TOOL_NAMES);
const PLAN_INTERACTION_TOOL_NAMES = new Set([
	PLAN_MODE_QUESTION_TOOL_NAME,
	PLAN_MODE_COMPLETE_TOOL_NAME,
]);
const PLAN_COMMAND_COMPLETIONS = [
	{ value: "start", label: "start", description: "Start Plan mode" },
	{ value: "show", label: "show", description: "Show the completed plan" },
	{ value: "finalize", label: "finalize", description: "Request a completed plan" },
	{ value: "implement", label: "implement", description: "Approve and implement the plan" },
	{ value: "cancel", label: "cancel", description: "Cancel Plan mode" },
	{ value: "exit", label: "exit", description: "Exit Plan mode" },
	{ value: "off", label: "off", description: "Exit Plan mode" },
] as const;

export default function managedPlanMode(pi: ExtensionAPI) {
	let state: ManagedPlanState = normalState([]);
	let workflowGeneration = 0;

	const persistState = () => pi.appendEntry<ManagedPlanState>(STATE_ENTRY_TYPE, state);

	pi.registerFlag("plan", {
		description: "Start in managed Plan mode",
		type: "boolean",
		default: false,
	});

	pi.registerTool({
		name: PLAN_MODE_QUESTION_TOOL_NAME,
		label: "Plan question",
		description:
			"Ask one to three clarification questions while the managed Plan workflow is active.",
		promptSnippet: "Ask user decision questions while Plan mode is active",
		promptGuidelines: [
			"Use plan_mode_question only for material decisions that read-only discovery cannot resolve.",
		],
		parameters: PLAN_MODE_QUESTION_PARAMS,
		async execute(_toolCallId, params: unknown, _signal, _onUpdate, ctx) {
			if (!isRestricted()) {
				return planModeQuestionCancelled(
					[],
					"plan_mode_inactive",
					"Error: plan_mode_question is only available while Plan mode is active.",
				);
			}

			const parsed = normalizePlanModeQuestionParams(params);
			if (!parsed.ok) {
				return planModeQuestionCancelled([], "invalid_input", `Error: ${parsed.error}`);
			}
			if (!ctx.hasUI) {
				return planModeQuestionCancelled(
					parsed.questions,
					"ui_unavailable",
					"Unable to ask Plan-mode questions because interactive UI is not available.",
				);
			}

			const generation = workflowGeneration;
			return answerPlanModeQuestions(parsed.questions, ctx, {
				isCurrent: () => generation === workflowGeneration,
				isEnabled: isRestricted,
			});
		},
	});

	pi.registerTool({
		name: PLAN_MODE_COMPLETE_TOOL_NAME,
		label: "Complete plan",
		description: "Present the complete implementation plan for operator approval.",
		promptSnippet: "Submit the final Plan-mode implementation plan",
		promptGuidelines: [
			"Call plan_mode_complete alone only after the plan is decision-complete.",
		],
		parameters: PLAN_MODE_COMPLETE_PARAMS,
		renderResult: renderPlanModeCompletion,
		async execute(_toolCallId, params: unknown, _signal, _onUpdate, ctx) {
			if (state.phase !== "planning") {
				throw new Error("plan_mode_complete is only available while planning");
			}
			const parsed = normalizePlanModeCompletion(params);
			if (!parsed.ok) throw new Error(parsed.error);

			state = {
				...state,
				phase: "awaiting-approval",
				latestPlan: parsed.plan,
			};
			persistState();
			updateUi(ctx);
			ctx.ui.notify(
				"Proposed plan ready for approval. Use /plan implement to approve or /plan cancel to discard it.",
				"info",
			);
			return planModeCompleted(parsed.plan);
		},
	});

	pi.registerCommand("plan", {
		description: "Enter or manage the cooperative Plan workflow",
		getArgumentCompletions: completePlanArguments,
		handler: async (args, ctx) => {
			const prompt = args.trim();
			const command = prompt.toLowerCase();
			if (command === "start") {
				if (isRestricted()) {
					ctx.ui.notify("Plan mode is already active.", "info");
					return;
				}
				enterPlanMode(ctx);
				return;
			}
			if (command === "show") {
				showPlan(ctx);
				return;
			}
			if (command === "finalize") {
				if (state.phase !== "planning") {
					ctx.ui.notify("Plan mode is not actively planning.", "warning");
					return;
				}
				sendPlanMessage(
					"Finalize the implementation plan now. Ask any remaining material question, otherwise call plan_mode_complete alone with the decision-ready plan.",
					ctx,
				);
				return;
			}
			if (command === "implement") {
				approvePlan(ctx);
				return;
			}
			if (command === "exit" || command === "off" || command === "cancel") {
				exitPlanMode(ctx, command === "cancel");
				return;
			}
			if (!prompt) {
				ctx.ui.notify(planStatusText(), "info");
				return;
			}

			const previousState = state;
			const previousNames = safeGetActiveTools();
			enterPlanMode(ctx);
			if (!sendPlanMessage(prompt, ctx)) {
				state = previousState;
				pi.setActiveTools(previousNames);
				persistState();
				updateUi(ctx);
			}
		},
	});

	pi.on("session_start", (event, ctx) => {
		workflowGeneration += 1;
		const restored = restoreManagedState(ctx.sessionManager.getBranch());
		if (restored.kind === "valid") {
			state = restored.state;
			if (isRestricted()) applyPlanTools();
			else restoreCapturedTools(ctx);
		} else if (restored.kind === "invalid" || event.reason === "resume") {
			const normalNames = safeGetActiveTools().filter(
				(name) => !PLAN_INTERACTION_TOOL_NAMES.has(name),
			);
			state = normalState(normalNames);
			pi.setActiveTools(normalNames);
			ctx.ui.notify(
				`Plan mode state was ${restored.kind} and was not restored; continuing in normal mode.`,
				"warning",
			);
			persistState();
		} else {
			deactivatePlanTools();
			state = normalState(safeGetActiveTools());
		}

		if (pi.getFlag("plan") === true && !isRestricted()) enterPlanMode(ctx);
		updateUi(ctx);
	});

	pi.on("before_agent_start", (event, ctx) => {
		if (!isRestricted()) return;
		if (state.phase === "awaiting-approval") {
			state = {
				phase: "planning",
				capturedToolNames: state.capturedToolNames,
			};
			persistState();
			updateUi(ctx);
		}
		applyPlanTools();
		return { systemPrompt: `${event.systemPrompt}\n\n${buildPlanModePrompt()}` };
	});

	pi.on("tool_call", (event) => {
		if (!isRestricted() || MANAGED_PLAN_TOOL_NAME_SET.has(event.toolName)) return;
		return {
			block: true,
			reason: `Plan mode denied non-allowlisted tool '${event.toolName}' before execution.`,
		};
	});

	pi.on("session_shutdown", async (_event, ctx) => {
		if (state.phase === "normal") {
			state = normalState(
				safeGetActiveTools().filter((name) => !PLAN_INTERACTION_TOOL_NAMES.has(name)),
			);
		}
		persistState();
		ctx.ui.setStatus(STATUS_KEY, undefined);
		ctx.ui.setWidget(PLAN_WIDGET_KEY, undefined);
	});

	function enterPlanMode(ctx: ExtensionContext) {
		workflowGeneration += 1;
		const capturedToolNames = isRestricted()
			? state.capturedToolNames
			: uniqueNames(safeGetActiveTools());
		state = {
			phase: "planning",
			capturedToolNames,
		};
		applyPlanTools();
		persistState();
		updateUi(ctx);
		ctx.ui.notify("Plan mode enabled with managed read-only discovery tools.", "info");
	}

	function approvePlan(ctx: ExtensionContext) {
		const plan = state.latestPlan?.trim();
		if (state.phase !== "awaiting-approval" || !plan) {
			ctx.ui.notify("No completed plan is awaiting approval.", "warning");
			return;
		}

		const previousState = state;
		workflowGeneration += 1;
		state = { ...state, phase: "approved" };
		persistState();
		restoreCapturedTools(ctx);
		updateUi(ctx);
		if (!sendPlanMessage(formatImplementationHandoff(plan), ctx)) {
			state = previousState;
			applyPlanTools();
			persistState();
			updateUi(ctx);
		}
	}

	function exitPlanMode(ctx: ExtensionContext, cancelled: boolean) {
		workflowGeneration += 1;
		restoreCapturedTools(ctx);
		state = normalState(state.capturedToolNames);
		persistState();
		updateUi(ctx);
		ctx.ui.notify(cancelled ? "Plan mode cancelled." : "Plan mode disabled.", "info");
	}

	function applyPlanTools() {
		const registeredNames = new Set(safeGetAllToolNames());
		pi.setActiveTools(MANAGED_PLAN_TOOL_NAMES.filter((name) => registeredNames.has(name)));
	}

	function restoreCapturedTools(ctx: ExtensionContext) {
		const registeredNames = new Set(safeGetAllToolNames());
		const available = state.capturedToolNames.filter((name) => registeredNames.has(name));
		const unavailable = state.capturedToolNames.filter((name) => !registeredNames.has(name));
		pi.setActiveTools(available);
		if (unavailable.length > 0) {
			ctx.ui.notify(`Captured Plan tools unavailable during restoration: ${unavailable.join(", ")}.`, "warning");
		}
	}

	function deactivatePlanTools() {
		const current = safeGetActiveTools();
		const normal = current.filter((name) => !PLAN_INTERACTION_TOOL_NAMES.has(name));
		if (normal.length !== current.length) pi.setActiveTools(normal);
	}

	function showPlan(ctx: ExtensionContext) {
		const plan = state.latestPlan?.trim();
		if (!plan) {
			ctx.ui.notify("No completed plan is available.", "info");
			return;
		}
		pi.sendMessage(
			{ customType: "proposed-plan", content: `**Proposed Plan**\n\n${plan}`, display: true },
			{ triggerTurn: false },
		);
	}

	function sendPlanMessage(message: string, ctx: ExtensionContext) {
		try {
			if (ctx.isIdle()) pi.sendUserMessage(message);
			else pi.sendUserMessage(message, { deliverAs: "followUp" });
			return true;
		} catch (error: unknown) {
			const detail = error instanceof Error ? error.message : String(error);
			ctx.ui.notify(`Unable to send Plan-mode message: ${detail}`, "error");
			return false;
		}
	}

	function updateUi(ctx: ExtensionContext) {
		ctx.ui.setStatus(
			STATUS_KEY,
			state.phase === "planning"
				? "plan active"
				: state.phase === "awaiting-approval"
					? "plan ready"
					: state.phase === "approved"
						? "plan approved"
						: undefined,
		);
		ctx.ui.setWidget(
			PLAN_WIDGET_KEY,
			state.phase === "planning"
				? ["Plan mode: planning", `Tools: ${MANAGED_PLAN_TOOL_NAMES.join(", ")}`]
				: state.phase === "awaiting-approval"
					? ["Proposed plan ready", "Use /plan implement to approve or /plan cancel."]
					: undefined,
		);
	}

	function planStatusText() {
		if (state.phase === "planning") return "Plan mode is active.";
		if (state.phase === "awaiting-approval") {
			return "A proposed plan is awaiting approval. Use /plan show, implement, or cancel.";
		}
		if (state.phase === "approved") return "The proposed plan was approved.";
		return "Plan mode is off.";
	}

	function isRestricted() {
		return state.phase === "planning" || state.phase === "awaiting-approval";
	}

	function safeGetActiveTools() {
		try {
			return pi.getActiveTools();
		} catch {
			return [];
		}
	}

	function safeGetAllToolNames() {
		try {
			return pi.getAllTools().map(({ name }) => name);
		} catch {
			return [];
		}
	}
}

function completePlanArguments(argumentPrefix: string) {
	const prefix = argumentPrefix.trimStart().toLowerCase();
	if (prefix === "") return [...PLAN_COMMAND_COMPLETIONS];
	if (/\s/u.test(prefix)) return null;
	const matches = PLAN_COMMAND_COMPLETIONS.filter(({ value }) => value.startsWith(prefix));
	return matches.length > 0 ? [...matches] : null;
}

function restoreManagedState(entries: unknown[]): RestoredState {
	const branch = entries as SessionEntry[];
	let entry: SessionEntry | undefined;
	for (let index = branch.length - 1; index >= 0; index -= 1) {
		const candidate = branch[index];
		if (candidate?.type === "custom" && candidate.customType === STATE_ENTRY_TYPE) {
			entry = candidate;
			break;
		}
	}
	if (!entry) return { kind: "unavailable" };
	if (!isRecord(entry.data)) return { kind: "invalid" };

	const phase = entry.data.phase;
	const capturedToolNames = entry.data.capturedToolNames;
	if (
		(phase !== "normal" &&
			phase !== "planning" &&
			phase !== "awaiting-approval" &&
			phase !== "approved") ||
		!Array.isArray(capturedToolNames) ||
		!capturedToolNames.every((name): name is string => typeof name === "string" && name.length > 0) ||
		new Set(capturedToolNames).size !== capturedToolNames.length
	) {
		return { kind: "invalid" };
	}

	const latestPlan = typeof entry.data.latestPlan === "string" ? entry.data.latestPlan.trim() : undefined;
	if ((phase === "awaiting-approval" || phase === "approved") && !latestPlan) {
		return { kind: "invalid" };
	}
	if ((phase === "normal" || phase === "planning") && entry.data.latestPlan !== undefined) {
		return { kind: "invalid" };
	}

	return {
		kind: "valid",
		state: {
			phase,
			capturedToolNames: [...capturedToolNames],
			...(latestPlan ? { latestPlan } : {}),
		},
	};
}

function normalState(capturedToolNames: string[]): ManagedPlanState {
	return { phase: "normal", capturedToolNames: uniqueNames(capturedToolNames) };
}

function uniqueNames(names: readonly string[]) {
	return [...new Set(names)];
}

function isRecord(value: unknown): value is Record<string, unknown> {
	return typeof value === "object" && value !== null && !Array.isArray(value);
}
