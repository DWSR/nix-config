+++ work/node_modules/@mrclrchtr/supi-lsp/src/client/failure.ts
@@ -0,0 +1,29 @@
+export type LspFailureCause =
+  | "timeout"
+  | "malformed-response"
+  | "server-error"
+  | "transport-error";
+
+function classifyLspFailure(error: unknown): LspFailureCause {
+  const record =
+    error !== null && typeof error === "object" ? (error as Record<string, unknown>) : null;
+  const name = record && typeof record.name === "string" ? record.name : "";
+  const message = error instanceof Error ? error.message : "";
+
+  if (/timed out|timeout/i.test(message)) return "timeout";
+  if (
+    error instanceof SyntaxError ||
+    /malformed|parse|invalid json|unexpected token|content-length/i.test(message)
+  ) {
+    return "malformed-response";
+  }
+  if (name === "ResponseError" || (record && typeof record.code === "number")) {
+    return "server-error";
+  }
+  return "transport-error";
+}
+
+/** Produce a value-free operational error with only managed identity and cause. */
+export function formatLspFailure(server: string, operation: string, error: unknown): string {
+  return `${server}: ${operation} failed (${classifyLspFailure(error)}).`;
+}
