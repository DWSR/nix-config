+  } catch {
+    return { kind: "error", reason: APPLY_FAILED };
+  } finally {
+    if (descriptor !== null) {
+      try {
+        closeSync(descriptor);
+      } catch {
+        // The source pathname has not been changed.
+      }
+    }
+    if (stagedExists) {
+      try {
+        rmSync(staged, { force: true });
+      } catch {
+        // A failed temp cleanup cannot alter the source pathname.
+      }
+    }
+  }
