+    const descriptor = openSync(realTarget, "r");
+    try {
+      const before = fstatSync(descriptor);
+      if (
+        !before.isFile() ||
+        before.dev !== expected.device ||
+        before.ino !== expected.inode
+      ) return null;
+      const bytes = readFileSync(descriptor);
+      const after = fstatSync(descriptor);
+      if (after.dev !== before.dev || after.ino !== before.ino || after.size !== before.size) {
+        return null;
+      }
+      const fingerprint = createHash("sha256").update(bytes).digest("hex");
+      if (fingerprint !== expected.fingerprint) return null;
+      return { bytes, mode: before.mode, uid: before.uid, gid: before.gid };
+    } finally {
+      closeSync(descriptor);
+    }
+  } catch {
+    return null;
+  }
+}
+
+function isContained(workspaceRoot: string, file: string): boolean {
+  const relative = path.relative(workspaceRoot, file);
+  return (
+    relative === "" ||
+    (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative))
+  );
+}
+
+function transformBytes(bytes: Buffer, edits: FileEdit[]): Buffer | null {
+  const content = bytes.toString("utf8");
+  if (!Buffer.from(content, "utf8").equals(bytes)) return null;
+  const lines = content.split("\n");
+  const sorted = [...edits].sort(
+    (left, right) =>
+      compareCodePositions(right.range.start, left.range.start) ||
+      compareCodePositions(right.range.end, left.range.end),
+  );
+
+  let updated = content;
+  for (const edit of sorted) {
+    const start = toOffset(lines, edit.range.start.line, edit.range.start.character);
+    const end = toOffset(lines, edit.range.end.line, edit.range.end.character);
+    if (start === null || end === null || end < start) return null;
+    updated = updated.slice(0, start) + edit.newText + updated.slice(end);
+  }
+  return Buffer.from(updated, "utf8");
+}
+
+function toOffset(lines: string[], line: number, character: number): number | null {
+  if (line < 0 || line >= lines.length || character < 0 || character > lines[line].length) {
+    return null;
+  }
+  let offset = 0;
+  for (let index = 0; index < line; index++) offset += lines[index].length + 1;
+  return offset + character;
+}
