+
+function readCurrentTarget(
+  workspaceRoot: string,
+  expected: FileFingerprint,
+): CurrentTarget | null {
+  try {
+    const realWorkspace = realpathSync.native(workspaceRoot);
+    if (realWorkspace !== workspaceRoot || !statSync(realWorkspace).isDirectory()) return null;
+    const realTarget = realpathSync.native(expected.file);
+    if (realTarget !== expected.file || !isContained(realWorkspace, realTarget)) return null;
+    if (realpathSync.native(path.dirname(realTarget)) !== path.dirname(realTarget)) return null;
