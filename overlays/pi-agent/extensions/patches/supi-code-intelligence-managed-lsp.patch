+import { withFileMutationQueue } from "@earendil-works/pi-coding-agent";
+import type { FileEdit, WorkspaceEdit } from "@mrclrchtr/supi-code-runtime/api";
+import type { FileFingerprint } from "../../session/refactor-plans.ts";
+import { compareCodePositions } from "./position.ts";
+import { validateEdit } from "./safety.ts";
+
+const STALE_PLAN = "Refactor plan is stale. Regenerate with code_refactor_plan.";
+const UNSUPPORTED_EDIT = "Refactor response is unsupported.";
+const APPLY_FAILED = "Refactor apply failed without changing the target.";
+
+export type ApplyResult =
+  | { kind: "applied"; filesChanged: 1; totalEdits: number }
+  | { kind: "error"; reason: string };
+
+export interface ApplyOptions {
+  readonly workspaceRoot: string;
+  readonly expectedFingerprint: FileFingerprint;
+}
+
+interface CurrentTarget {
+  readonly bytes: Buffer;
+  readonly mode: number;
+  readonly uid: number;
+  readonly gid: number;
+}
+
+/** Revalidate and atomically replace exactly one canonical workspace file. */
+export async function applyWorkspaceEdit(
+  edit: WorkspaceEdit,
+  options: ApplyOptions,
+): Promise<ApplyResult> {
+  const target = validateApplyInput(edit, options);
+  if (!target) return { kind: "error", reason: UNSUPPORTED_EDIT };
+  return withFileMutationQueue(target, async () => applyLocked(edit, options));
+}
+
+function validateApplyInput(edit: WorkspaceEdit, options: ApplyOptions): string | null {
+  const validation = validateEdit(edit);
+  if (!validation.safe || edit.edits.length === 0) return null;
+  if (!path.isAbsolute(options.workspaceRoot) || !path.isAbsolute(options.expectedFingerprint.file)) {
+    return null;
+  }
+  const files = new Set(edit.edits.map(({ file }) => file));
+  if (files.size !== 1 || !files.has(options.expectedFingerprint.file)) return null;
+  return options.expectedFingerprint.file;
+}
+
+function applyLocked(edit: WorkspaceEdit, options: ApplyOptions): ApplyResult {
+  const current = readCurrentTarget(options.workspaceRoot, options.expectedFingerprint);
+  if (!current) return { kind: "error", reason: STALE_PLAN };
+  const transformed = transformBytes(current.bytes, edit.edits);
+  if (!transformed) return { kind: "error", reason: UNSUPPORTED_EDIT };
+
+  const target = options.expectedFingerprint.file;
+  const staged = path.join(
+    path.dirname(target),
+    `.${path.basename(target)}.supi-refactor-${randomUUID()}.tmp`,
+  );
+  let descriptor: number | null = null;
+  let stagedExists = false;
+  try {
+    descriptor = openSync(staged, "wx", 0o600);
+    stagedExists = true;
+    writeFileSync(descriptor, transformed);
+    const stagedOwner = fstatSync(descriptor);
+    if (stagedOwner.uid !== current.uid || stagedOwner.gid !== current.gid) {
+      fchownSync(descriptor, current.uid, current.gid);
+    }
+    fchmodSync(descriptor, current.mode & 0o7777);
+    const stagedMetadata = fstatSync(descriptor);
+    if (
+      (stagedMetadata.mode & 0o7777) !== (current.mode & 0o7777) ||
+      stagedMetadata.uid !== current.uid ||
+      stagedMetadata.gid !== current.gid
+    ) {
+      throw new Error("Staged refactor metadata verification failed.");
+    }
+    fsyncSync(descriptor);
+    closeSync(descriptor);
+    descriptor = null;
+
+    const revalidated = readCurrentTarget(options.workspaceRoot, options.expectedFingerprint);
+    if (
+      !revalidated ||
+      (revalidated.mode & 0o7777) !== (current.mode & 0o7777) ||
+      revalidated.uid !== current.uid ||
+      revalidated.gid !== current.gid
+    ) {
+      return { kind: "error", reason: STALE_PLAN };
+    }
