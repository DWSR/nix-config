@@ -0,0 +1,138 @@
+import { accessSync, constants, lstatSync, realpathSync, statSync } from "node:fs";
+import * as path from "node:path";
+import type {
+  ManagedLspUnavailable,
+  ManagedLspUnavailableCause,
+  ServerConfig,
+} from "./server-config.ts";
+
+export const MANAGED_LSP_EXECUTABLES_BINDING = "PI_AGENT_LSP_EXECUTABLES";
+
+const SAFE_SERVER_ID = /^[A-Za-z0-9][A-Za-z0-9._+,:=@~-]*$/;
+const STORE_EXECUTABLE = /^\/nix\/store\/[0-9a-z]{32}-[^/]+\/[A-Za-z0-9._+,:=@~\/-]+$/;
+
+interface ManagedLspConfig {
+  readonly servers: Record<string, ServerConfig>;
+  readonly unavailableServers: ManagedLspUnavailable[];
+}
+
+type ExecutableValidation =
+  | { readonly valid: true; readonly realTarget: string }
+  | { readonly valid: false; readonly cause: ManagedLspUnavailableCause };
+
+function invalidManagedMap(cause: string): never {
+  throw new Error(`Invalid managed LSP executable map: ${cause}.`);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function canonicalPayload(value: Record<string, unknown>): string {
+  const sorted: Record<string, unknown> = Object.create(null);
+  for (const name of Object.keys(value).sort()) sorted[name] = value[name];
+  return JSON.stringify(sorted);
+}
+
+function isCanonicalStoreExecutable(value: string): boolean {
+  if (!STORE_EXECUTABLE.test(value) || path.posix.normalize(value) !== value) return false;
+  const segments = value.split("/");
+  return !segments.some((segment) => segment === "." || segment === "..");
+}
+
+function validateExecutable(value: unknown): ExecutableValidation {
+  if (typeof value !== "string" || !isCanonicalStoreExecutable(value)) {
+    return { valid: false, cause: "invalid-path" };
+  }
+
+  let realTarget: string;
+  try {
+    lstatSync(value);
+    realTarget = realpathSync.native(value);
+  } catch {
+    return { valid: false, cause: "unavailable-executable" };
+  }
+  if (!isCanonicalStoreExecutable(realTarget)) {
+    return { valid: false, cause: "invalid-path" };
+  }
+
+  try {
+    if (!statSync(realTarget).isFile()) {
+      return { valid: false, cause: "unavailable-executable" };
+    }
+    accessSync(realTarget, constants.X_OK);
+  } catch {
+    return { valid: false, cause: "unavailable-executable" };
+  }
+  return { valid: true, realTarget };
+}
+
+/** Decode the byte-canonical launcher projection of ManagedConfigV1.lspExecutables. */
+export function loadManagedLspExecutableMap(
+  serialized: string | undefined = process.env[MANAGED_LSP_EXECUTABLES_BINDING],
+): Readonly<Record<string, unknown>> {
+  if (serialized === undefined) invalidManagedMap("binding is missing");
+
+  let value: unknown;
+  try {
+    value = JSON.parse(serialized);
+  } catch {
+    invalidManagedMap("binding is malformed JSON");
+  }
+  if (!isRecord(value) || Object.getPrototypeOf(value) !== Object.prototype) {
+    invalidManagedMap("expected a JSON object");
+  }
+  if (canonicalPayload(value) !== serialized) {
+    invalidManagedMap("binding is not canonical JSON");
+  }
+  return Object.freeze(value);
+}
+
+/** Select fixed catalog metadata while isolating each invalid or unavailable entry. */
+export function loadManagedLspServers(
+  catalog: Readonly<Record<string, ServerConfig>>,
+  serialized?: string,
+): ManagedLspConfig {
+  const executables = loadManagedLspExecutableMap(serialized);
+  const servers: Record<string, ServerConfig> = {};
+  const unavailableServers: ManagedLspUnavailable[] = [];
+  const realTargets = new Set<string>();
+
+  for (const name of Object.keys(executables).sort()) {
+    const fixed = SAFE_SERVER_ID.test(name) && Object.hasOwn(catalog, name) ? catalog[name] : undefined;
+    if (!fixed) {
+      unavailableServers.push({ cause: "unknown-server", fileTypes: [] });
+      continue;
+    }
+
+    const validation = validateExecutable(executables[name]);
+    if (!validation.valid) {
+      unavailableServers.push({
+        name,
+        cause: validation.cause,
+        fileTypes: [...fixed.fileTypes],
+      });
+      continue;
+    }
+    if (realTargets.has(validation.realTarget)) {
+      unavailableServers.push({
+        name,
+        cause: "duplicate-executable",
+        fileTypes: [...fixed.fileTypes],
+      });
+      continue;
+    }
+    realTargets.add(validation.realTarget);
+
+    // Package-to-ID provenance is trusted launcher input owned by Tasks 5.7 and 6.2.
+    // This boundary validates bytes, catalog membership, path identity, and executability only.
+    servers[name] = {
+      ...fixed,
+      command: executables[name] as string,
