@@ -0,0 +1,126 @@
+export interface ProcessGroupOperations {
+  readonly probe: (processGroupId: number) => unknown;
+  readonly signal: (processGroupId: number, signal: NodeJS.Signals) => unknown;
+}
+
+export interface ProcessGroupTerminationOptions {
+  readonly gracefulMs: number;
+  readonly termMs: number;
+  readonly killMs: number;
+}
+
+export interface ProcessGroupTerminationResult {
+  readonly finalSignal: "SIGTERM" | "SIGKILL" | null;
+  readonly groupAlreadyReleased: boolean;
+}
+
+const POLL_INTERVAL_MS = 20;
+const LOCAL_OPERATIONS: ProcessGroupOperations = Object.freeze({
+  probe: (processGroupId: number) => process.kill(-processGroupId, 0),
+  signal: (processGroupId: number, signal: NodeJS.Signals) =>
+    process.kill(-processGroupId, signal),
+});
+
+function errorCode(error: unknown): unknown {
+  return error !== null && typeof error === "object" && "code" in error
+    ? (error as { code?: unknown }).code
+    : undefined;
+}
+
+function delay(milliseconds: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, milliseconds));
+}
+
+/** Own one detached process group until the first terminal ESRCH observation. */
+export class RegisteredProcessGroup {
+  #processGroupId: number | null;
+  #termination: Promise<ProcessGroupTerminationResult> | null = null;
+
+  constructor(
+    processGroupId: number,
+    private readonly operations: ProcessGroupOperations = LOCAL_OPERATIONS,
+  ) {
+    if (!Number.isInteger(processGroupId) || processGroupId <= 0) {
+      throw new Error("Managed language-server process-group registration failed.");
+    }
+    this.#processGroupId = processGroupId;
+  }
+
+  get active(): boolean {
+    return this.#processGroupId !== null;
+  }
+
+  async terminate(
+    options: ProcessGroupTerminationOptions,
+  ): Promise<ProcessGroupTerminationResult> {
+    if (this.#termination) return this.#termination;
+    const operation = this.#terminate(options);
+    this.#termination = operation;
+    try {
+      return await operation;
+    } finally {
+      if (this.#termination === operation) this.#termination = null;
+    }
+  }
+
+  async #terminate(
+    options: ProcessGroupTerminationOptions,
+  ): Promise<ProcessGroupTerminationResult> {
+    if (await this.#waitForEnd(options.gracefulMs)) {
+      return { finalSignal: null, groupAlreadyReleased: true };
+    }
+    if (!this.#signal("SIGTERM")) {
+      return { finalSignal: null, groupAlreadyReleased: true };
+    }
+    if (await this.#waitForEnd(options.termMs)) {
+      return { finalSignal: "SIGTERM", groupAlreadyReleased: false };
+    }
+    if (!this.#signal("SIGKILL")) {
+      return { finalSignal: "SIGTERM", groupAlreadyReleased: false };
+    }
+    if (!await this.#waitForEnd(options.killMs)) {
+      throw new Error("Managed language-server process group remained after SIGKILL.");
+    }
+    return { finalSignal: "SIGKILL", groupAlreadyReleased: false };
+  }
+
+  async #waitForEnd(timeoutMs: number): Promise<boolean> {
+    const deadline = Date.now() + timeoutMs;
+    while (true) {
+      if (!this.#exists()) return true;
+      const remainingMs = deadline - Date.now();
+      if (remainingMs <= 0) return false;
+      await delay(Math.min(POLL_INTERVAL_MS, remainingMs));
+    }
+  }
+
+  #exists(): boolean {
+    const processGroupId = this.#processGroupId;
+    if (processGroupId === null) return false;
+    try {
+      this.operations.probe(processGroupId);
+      return true;
+    } catch (error) {
+      if (errorCode(error) === "ESRCH") {
+        this.#processGroupId = null;
+        return false;
+      }
+      throw new Error("Managed language-server process-group probe failed.");
+    }
+  }
+
+  #signal(signal: NodeJS.Signals): boolean {
+    const processGroupId = this.#processGroupId;
+    if (processGroupId === null) return false;
+    try {
+      this.operations.signal(processGroupId, signal);
+      return true;
+    } catch (error) {
+      if (errorCode(error) === "ESRCH") {
+        this.#processGroupId = null;
+        return false;
+      }
+      throw new Error(`Managed language-server process-group ${signal} failed.`);
+    }
+  }
+}
