+function cloneDirectToolSelection(
+  selection: McpAdapterOptions["directTools"],
+): readonly McpDirectToolSelection[] | undefined {
+  if (selection === undefined) return undefined;
+  const servers = new Set<string>();
+  return Object.freeze(selection.map((entry) => {
+    if (!entry || typeof entry !== "object") {
+      throw new TypeError("MCP directTools entries must be objects");
+    }
+    const server = entry.server.trim();
+    if (!server) throw new Error("MCP directTools server must not be empty");
+    if (servers.has(server)) throw new Error(`MCP directTools contains duplicate server: ${server}`);
+    servers.add(server);
+    if (!Array.isArray(entry.tools) || entry.tools.length === 0) {
+      throw new Error(`MCP directTools for ${server} must contain at least one tool`);
+    }
+    const tools = entry.tools.map(tool => tool.trim());
+    if (tools.some(tool => !tool)) {
+      throw new Error(`MCP directTools for ${server} contains an empty tool name`);
+    }
+    if (new Set(tools).size !== tools.length) {
+      throw new Error(`MCP directTools for ${server} contains duplicate tool names`);
+    }
+    return Object.freeze({ server, tools: Object.freeze(tools) });
+  }));
+}
