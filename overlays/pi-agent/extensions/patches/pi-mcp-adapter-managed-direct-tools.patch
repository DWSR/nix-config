+
+function consumeTextBytes(budget: JsonCloneBudget, bytes: number): void {
+  if (budget.textBytes + bytes > DIRECT_TOOL_JSON_LIMITS.textBytes) {
+    failDirectToolSchema("JSON_TEXT_LIMIT");
+  }
+  budget.textBytes += bytes;
+}
+
+function defineJsonValue(
+  target: Record<string, unknown> | unknown[],
+  key: string,
+  value: unknown,
+): void {
+  Object.defineProperty(target, key, {
+    configurable: true,
+    enumerable: true,
+    writable: true,
+    value,
+  });
