+function validateClonedDirectToolInputSchema(schema: unknown): Record<string, unknown> {
+  if (schema === null || typeof schema !== "object" || Array.isArray(schema)) {
+    failDirectToolSchema("SCHEMA_ROOT_OBJECT");
+  }
+  const inputSchema = schema as Record<string, unknown>;
+  if (inputSchema.type !== "object") failDirectToolSchema("SCHEMA_ROOT_TYPE");
+
+  const dialect = typeof inputSchema.$schema === "string"
+    ? inputSchema.$schema.replace(/#$/, "")
+    : undefined;
+  const draft7 = dialect === "http://json-schema.org/draft-07/schema"
+    || dialect === "https://json-schema.org/draft-07/schema";
+  if (!draft7 && dialect !== undefined && dialect !== "https://json-schema.org/draft/2020-12/schema") {
+    failDirectToolSchema("SCHEMA_DIALECT_UNSUPPORTED");
+  }
+  const options = { strict: false, allErrors: true, validateFormats: false } as const;
+  try {
+    if (draft7) {
+      new Ajv(options).compile(inputSchema);
+    } else {
+      const Ajv2020 = Ajv2020Import as unknown as typeof Ajv;
+      new Ajv2020(options).compile(inputSchema);
+    }
+  } catch {
+    failDirectToolSchema("SCHEMA_INVALID");
+  }
+  return inputSchema;
+}
