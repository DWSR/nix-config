+
+function failDirectToolSchema(reason: DirectToolSchemaFailureReason): never {
+  throw new DirectToolSchemaFailure(reason);
+}
+
+function createJsonCloneBudget(): JsonCloneBudget {
+  return { nodes: 0, textBytes: 0, seen: new Set<object>() };
