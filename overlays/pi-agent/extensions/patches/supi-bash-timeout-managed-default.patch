 // Bash Timeout — inject default timeouts on bash tool calls.
 //
 // The pi bash tool accepts an optional `timeout` parameter, but the LLM
-// doesn't always specify one.  In a headless gateway daemon with no human
-// watching, a single hung command (e.g. `find /` over a huge filesystem)
-// blocks all subsequent messages indefinitely.
+// doesn't always specify one. The managed launcher supplies the default in
+// milliseconds and Pi continues to own timeout validation and enforcement.
 //
 // This extension intercepts every bash `tool_call` event and sets a default
-// timeout when the LLM omits one.  The timeout is configurable via
-// /supi-settings or the SuPi config system (default 120s).
+// timeout when the LLM omits one. Mutable Supi settings are intentionally not
+// part of this managed runtime contract.
 
 import { type ExtensionAPI, isToolCallEventType } from "@earendil-works/pi-coding-agent";
-import { loadBashTimeoutConfig } from "./config.ts";
-import { registerBashTimeoutSettings } from "./settings-registration.ts";
+import { TIMEOUT_BINDING, parseManagedTimeoutSeconds } from "./managed-timeout.ts";
 
 export default function bashTimeout(pi: ExtensionAPI) {
-  registerBashTimeoutSettings(pi);
+  const defaultTimeout = parseManagedTimeoutSeconds(process.env[TIMEOUT_BINDING]);
+
+  // TypeBox converts null numeric input to zero before tool_call, so resolve
+  // model-authored null while the original assistant message is still available.
+  pi.on("message_end", async (event) => {
+    if (event.message.role !== "assistant") return;
+
+    let modified = false;
+    const content = event.message.content.map((item) => {
+      if (
+        item.type !== "toolCall" ||
+        item.name !== "bash" ||
+        typeof item.arguments !== "object" ||
+        item.arguments === null ||
+        item.arguments.timeout !== null
+      ) {
+        return item;
+      }
+
+      modified = true;
+      return {
+        ...item,
+        arguments: { ...item.arguments, timeout: defaultTimeout },
+      };
+    });
+
+    if (!modified) return;
+    return {
+      message: { ...event.message, content },
+    };
+  });
 
-  pi.on("tool_call", async (event, ctx) => {
+  pi.on("tool_call", async (event) => {
     if (!isToolCallEventType("bash", event)) return;
 
     // Only inject when the LLM didn't specify a timeout
     if (event.input.timeout !== undefined && event.input.timeout !== null) return;
 
-    const config = loadBashTimeoutConfig(ctx.cwd);
-    event.input.timeout = config.defaultTimeout;
+    event.input.timeout = defaultTimeout;
   });
 }
diff --git a/src/managed-timeout.ts b/src/managed-timeout.ts
new file mode 100644
--- /dev/null
+++ b/src/managed-timeout.ts
@@ -0,0 +1,34 @@
+export const TIMEOUT_BINDING = "PI_AGENT_BASH_TIMEOUT_MS";
+const MAX_TIMEOUT_MS = 2_147_483_647;
+const INVALID_TIMEOUT_BINDING =
+  `Invalid ${TIMEOUT_BINDING}: expected a decimal integer from 1 through ${MAX_TIMEOUT_MS} milliseconds`;
+const UNSAFE_TIMEOUT_CONVERSION =
+  "Unable to represent managed Bash timeout without timer truncation";
+
+function nextUp(value: number): number {
+  const buffer = new ArrayBuffer(8);
+  const view = new DataView(buffer);
+  view.setFloat64(0, value);
+  view.setBigUint64(0, view.getBigUint64(0) + 1n);
+  return view.getFloat64(0);
+}
+
+export function parseManagedTimeoutSeconds(raw: unknown): number {
+  if (typeof raw !== "string" || !/^[0-9]+$/.test(raw)) {
+    throw new Error(INVALID_TIMEOUT_BINDING);
+  }
+
+  const milliseconds = Number(raw);
+  if (!Number.isInteger(milliseconds) || milliseconds < 1 || milliseconds > MAX_TIMEOUT_MS) {
+    throw new Error(INVALID_TIMEOUT_BINDING);
+  }
+
+  let seconds = milliseconds / 1000;
+  while (Math.trunc(seconds * 1000) < milliseconds) {
+    seconds = nextUp(seconds);
+  }
+  if (Math.trunc(seconds * 1000) !== milliseconds) {
+    throw new Error(UNSAFE_TIMEOUT_CONVERSION);
+  }
+  return seconds;
+}
