import * as fs from "node:fs";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const PACKAGE_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const CATALOG_PATH = path.resolve(PACKAGE_ROOT, "..", "..", "..", "share", "pi-agent", "subagents.json");
const EXTENSION_ROOT = path.resolve(PACKAGE_ROOT, "..", "..", "pi-agent", "extensions");
const MANAGED_AGENT_DIR = path.join(PACKAGE_ROOT, "managed-agents");
const MANAGED_MAX_DEPTH = 1 as const;
const ROLE_NAMES = ["reader", "worker"] as const;
const MCP_SELECTORS = new Map([
  ["retrieve_tools", "mcpproxy/retrieve_tools"],
  ["describe_tool", "mcpproxy/describe_tool"],
  ["call_tool_read", "mcpproxy/call_tool_read"],
  ["read_cache", "mcpproxy/read_cache"],
]);
const MCP_NAMES = new Map([...MCP_SELECTORS].map(([name, selector]) => [selector, name]));
const MANAGED_CHILDREN_KEY = Symbol.for("pi-subagents.managed-foreground-children.v1");
const PROCESS_GROUP_POLL_MS = 20;
const ASYNC_ACTIONS = new Set(["append-step", "resume", "steer"]);
export const MANAGED_CHILD_TERMINATION = Object.freeze({ gracefulMs: 1000, forcedMs: 1000 });

interface ManagedChildProcess {
  readonly pid?: number;
  kill(signal?: NodeJS.Signals): boolean;
}

interface ManagedChildState {
  readonly child: ManagedChildProcess;
  readonly pid: number;
  readonly processGroupId: number | null;
  released: boolean;
  termination: Promise<void> | null;
}

interface ManagedChildrenState {
  accepting: boolean;
  readonly children: Map<number, ManagedChildState>;
}

export interface ManagedForegroundChild {
  signal(signal: NodeJS.Signals): boolean;
  terminate(): Promise<void>;
  leaderExited(): Promise<void>;
  release(): Promise<void>;
}

function managedChildrenState(): ManagedChildrenState {
  const store = globalThis as unknown as Record<PropertyKey, unknown>;
  const existing = store[MANAGED_CHILDREN_KEY];
  if (existing && typeof existing === "object" && "children" in existing) return existing as ManagedChildrenState;
  const created: ManagedChildrenState = { accepting: true, children: new Map() };
  store[MANAGED_CHILDREN_KEY] = created;
  return created;
}

function managedChildren(): Map<number, ManagedChildState> {
  return managedChildrenState().children;
}

function errorCode(error: unknown): string | undefined {
  return error && typeof error === "object" && "code" in error && typeof error.code === "string"
    ? error.code
    : undefined;
}

function releaseManagedChild(state: ManagedChildState): void {
  state.released = true;
  const children = managedChildren();
  if (children.get(state.pid) === state) children.delete(state.pid);
}

function managedChildExists(state: ManagedChildState): boolean {
  if (state.released) return false;
  const target = state.processGroupId === null ? state.pid : -state.processGroupId;
  try {
    process.kill(target, 0);
    return true;
  } catch (error) {
    const code = errorCode(error);
    if (code === "ESRCH") {
      releaseManagedChild(state);
      return false;
    }
    if (code === "EPERM") return true;
    throw new Error("Managed subagent child process-group probe failed.");
  }
}

function signalManagedChild(state: ManagedChildState, signal: NodeJS.Signals): boolean {
  if (state.released) return false;
  try {
    if (state.processGroupId === null) return state.child.kill(signal);
    process.kill(-state.processGroupId, signal);
    return true;
  } catch (error) {
    if (errorCode(error) === "ESRCH") {
      releaseManagedChild(state);
      return false;
    }
    throw new Error("Managed subagent child process-group signal failed.");
  }
}

async function waitForManagedChildRelease(state: ManagedChildState, timeoutMs: number): Promise<boolean> {
  const deadline = Date.now() + timeoutMs;
  while (managedChildExists(state)) {
    const remainingMs = deadline - Date.now();
    if (remainingMs <= 0) return false;
    await new Promise((resolve) => setTimeout(resolve, Math.min(PROCESS_GROUP_POLL_MS, remainingMs)));
  }
  return true;
}

function terminateManagedChild(state: ManagedChildState): Promise<void> {
  if (state.termination) return state.termination;
  state.termination = (async () => {
    if (!managedChildExists(state)) return;
    signalManagedChild(state, "SIGTERM");
    if (await waitForManagedChildRelease(state, MANAGED_CHILD_TERMINATION.gracefulMs)) return;
    signalManagedChild(state, "SIGKILL");
    if (!await waitForManagedChildRelease(state, MANAGED_CHILD_TERMINATION.forcedMs)) {
      throw new Error("Managed subagent child process group remained after SIGKILL.");
    }
  })().finally(() => {
    if (!managedChildExists(state)) releaseManagedChild(state);
  });
  return state.termination;
}

export function beginManagedChildSession(): void {
  const state = managedChildrenState();
  if (state.children.size > 0) throw new Error("Managed subagent child cleanup is incomplete.");
  state.accepting = true;
}

export function assertManagedForegroundSpawnAllowed(): void {
  if (!managedChildrenState().accepting) throw new Error("Managed subagent child spawn rejected during session shutdown.");
}

export function managedForegroundSpawnDetached(): boolean {
  return process.platform !== "win32";
}

export function registerManagedForegroundChild(child: ManagedChildProcess): ManagedForegroundChild {
  const pid = child.pid;
  if (!Number.isInteger(pid) || (pid ?? 0) < 1) {
    return {
      signal: (signal) => child.kill(signal),
      terminate: async () => {},
      leaderExited: async () => {},
      release: async () => {},
    };
  }
  const state: ManagedChildState = {
    child,
    pid: pid!,
    processGroupId: process.platform === "win32" ? null : pid!,
    released: false,
    termination: null,
  };
  managedChildren().set(state.pid, state);
  return {
    signal: (signal) => signalManagedChild(state, signal),
    terminate: () => terminateManagedChild(state),
    leaderExited: () => terminateManagedChild(state),
    release: () => terminateManagedChild(state),
  };
}

export async function terminateManagedForegroundChildren(): Promise<void> {
  const state = managedChildrenState();
  state.accepting = false;
  const outcomes = await Promise.allSettled([...state.children.values()].map(terminateManagedChild));
  if (outcomes.some((outcome) => outcome.status === "rejected")) {
    throw new Error("Managed subagent child cleanup failed.");
  }
}

type ManagedRoleName = (typeof ROLE_NAMES)[number];
interface ManagedRole {
  model: "host-managed-default";
  maxTurns: number;
  maxToolCalls: number;
  workspace: "parent-read" | "parent-readwrite";
  tools: string[];
  extensions: Array<"cavemem" | "mcp">;
  mcp: "none" | "read-only";
}
interface ManagedCatalog {
  schemaVersion: 1;
  reader: ManagedRole;
  worker: ManagedRole;
}
interface ManagedAgentConfig {
  name: ManagedRoleName;
  description: string;
  tools: string[];
  mcpDirectTools?: string[];
  systemPromptMode: "replace";
  inheritProjectContext: false;
  inheritSkills: false;
  defaultContext: "fresh";
  defaultTurnBudget: { maxTurns: number; graceTurns: 0 };
  toolBudget: { hard: number; block: "*" };
  systemPrompt: string;
  source: "package";
  filePath: string;
  extensions: string[];
}

const catalog = JSON.parse(fs.readFileSync(CATALOG_PATH, "utf8")) as ManagedCatalog;
if (catalog.schemaVersion !== 1 || Object.keys(catalog).sort().join(",") !== "reader,schemaVersion,worker") {
  throw new Error("Managed subagent catalog is invalid");
}

const OVERRIDE_FIELDS = new Set([
  "model",
  "thinking",
  "fallbackModels",
  "budget",
  "turnBudget",
  "toolBudget",
  "usageBudget",
  "maxTurns",
  "maxToolCalls",
  "timeoutMs",
  "maxRuntimeMs",
  "tools",
  "workspace",
  "cwd",
  "context",
  "worktree",
  "worktreeSetupHook",
  "worktreeBaseDir",
  "extensions",
  "subagentOnlyExtensions",
  "mcp",
  "mcpDirectTools",
  "depth",
  "maxSubagentDepth",
  "output",
  "outputMode",
  "outputSchema",
  "maxOutput",
  "artifacts",
  "sessionDir",
  "chainDir",
  "reads",
  "skill",
  "skills",
  "agentScope",
  "scope",
]);

function isManagedRole(value: unknown): value is ManagedRoleName {
  return typeof value === "string" && (ROLE_NAMES as readonly string[]).includes(value);
}

function childPath(parent: string, key: string): string {
  return /^\d+$/.test(key) ? `${parent}[${key}]` : parent ? `${parent}.${key}` : key;
}

function findRejectedOverride(value: unknown): string | undefined {
  const pending: Array<{ value: unknown; path: string }> = [{ value, path: "" }];
  const seen = new WeakSet<object>();
  while (pending.length > 0) {
    const current = pending.pop()!;
    if (!current.value || typeof current.value !== "object") continue;
    if (seen.has(current.value)) continue;
    seen.add(current.value);
    for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(current.value))) {
      const fieldPath = childPath(current.path, key);
      if (OVERRIDE_FIELDS.has(key)) return fieldPath;
      if (!("value" in descriptor)) continue;
      if (key === "agent" && !isManagedRole(descriptor.value)) {
        return fieldPath;
      }
      pending.push({ value: descriptor.value, path: fieldPath });
    }
  }
  return undefined;
}

function findRejectedChildMode(value: unknown): "asynchronous" | "detached" | "scheduled" | undefined {
  const pending: unknown[] = [value];
  const seen = new WeakSet<object>();
  let asynchronous = false;
  let detached = false;
  let scheduled = false;
  while (pending.length > 0) {
    const current = pending.pop();
    if (!current || typeof current !== "object" || seen.has(current)) continue;
    seen.add(current);
    for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(current))) {
      if (!("value" in descriptor)) continue;
      const child = descriptor.value;
      if (key === "async" && child === true) asynchronous = true;
      if ((key === "detach" || key === "detached") && child !== false && child !== undefined) detached = true;
      if (key === "schedule" || key === "scheduleName") scheduled = true;
      if (key === "action" && typeof child === "string") {
        asynchronous ||= ASYNC_ACTIONS.has(child);
        detached ||= child === "detach";
        scheduled ||= child === "schedule" || child.startsWith("schedule-");
      }
      pending.push(child);
    }
  }
  return asynchronous ? "asynchronous" : detached ? "detached" : scheduled ? "scheduled" : undefined;
}

function findRejectedChainTask(chain: unknown[]): string | undefined {
  for (let index = 0; index < chain.length; index += 1) {
    const pending: Array<{ value: unknown; path: string }> = [{ value: chain[index], path: `chain[${index}]` }];
    const seen = new WeakSet<object>();
    while (pending.length > 0) {
      const current = pending.pop()!;
      if (!current.value || typeof current.value !== "object") continue;
      if (seen.has(current.value)) continue;
      seen.add(current.value);
      for (const [key, descriptor] of Object.entries(Object.getOwnPropertyDescriptors(current.value))) {
        const fieldPath = childPath(current.path, key);
        if (!("value" in descriptor)) continue;
        if (key === "task" && typeof descriptor.value === "string") {
          if ((index === 0 && descriptor.value.includes("{previous}")) || descriptor.value.includes("{outputs.")) {
            return fieldPath;
          }
        }
        pending.push({ value: descriptor.value, path: fieldPath });
      }
    }
  }
  return undefined;
}

export function validateManagedExecutionRequest(value: unknown): string | undefined {
  const rejectedMode = findRejectedChildMode(value);
  if (rejectedMode) return `Managed subagent policy rejects ${rejectedMode} child execution.`;
  const rejected = findRejectedOverride(value);
  if (rejected) {
    return `Managed subagent policy rejects call-level override or agent '${rejected}'.`;
  }
  const chain = value && typeof value === "object" && "chain" in value
    ? (value as { chain?: unknown }).chain
    : undefined;
  if (Array.isArray(chain)) {
    const rejectedTask = findRejectedChainTask(chain);
    if (rejectedTask) return `Managed subagent chain input at ${rejectedTask} may reference only its immediate predecessor.`;
  }
  return undefined;
}

export function managedMaximumDepth(): 1 {
  return MANAGED_MAX_DEPTH;
}

export function managedAgentDirectory(): string {
  return MANAGED_AGENT_DIR;
}

export function managedAgentResources(name: string): {
  turnBudget: { maxTurns: number; graceTurns: 0 };
  toolBudget: { hard: number; block: "*" };
} | undefined {
  if (!isManagedRole(name)) return undefined;
  const role = catalog[name];
  return {
    turnBudget: { maxTurns: role.maxTurns, graceTurns: 0 },
    toolBudget: { hard: role.maxToolCalls, block: "*" },
  };
}

export function resolveManagedMcpDirectToolSelections(selectors: string[] | undefined): Array<{
  name: string;
  selector: string;
}> {
  if (!selectors) return [];
  return selectors.map((selector) => {
    const name = MCP_NAMES.get(selector);
    if (!name) throw new Error("Managed subagent MCP selection is invalid");
    return { name, selector };
  });
}

function extensionPath(name: "cavemem" | "mcp"): string {
  return path.join(EXTENSION_ROOT, name === "cavemem" ? "cavemem/index.ts" : "mcpproxy/index.ts");
}

export function createManagedAgents(): ManagedAgentConfig[] {
  return ROLE_NAMES.map((name) => {
    const role = catalog[name];
    const resources = managedAgentResources(name)!;
    const mcpDirectTools = role.tools
      .map((tool) => MCP_SELECTORS.get(tool))
      .filter((tool): tool is string => Boolean(tool));
    const localTools = role.tools.filter((tool) => !MCP_SELECTORS.has(tool));
    return {
      name,
      description: name === "reader" ? "Managed read-only research child" : "Managed implementation child",
      tools: [...localTools],
      ...(mcpDirectTools.length > 0 ? { mcpDirectTools } : {}),
      systemPromptMode: "replace",
      inheritProjectContext: false,
      inheritSkills: false,
      defaultContext: "fresh",
      defaultTurnBudget: { ...resources.turnBudget },
      toolBudget: { ...resources.toolBudget },
      systemPrompt: name === "reader"
        ? "Investigate the assigned task using only the managed read-only resources and return a concise result."
        : "Complete the assigned task within the managed workspace and return the result to the parent.",
      source: "package",
      filePath: path.join(MANAGED_AGENT_DIR, `${name}.md`),
      extensions: role.extensions.map(extensionPath),
    };
  });
}
