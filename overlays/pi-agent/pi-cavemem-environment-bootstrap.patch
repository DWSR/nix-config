From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DWSR <noreply@dwsr.dev>
Date: Sun, 16 Aug 2026 13:42:20 -0400
Subject: [PATCH] feat(coding-agent): expose Cavemem process environment

Task: pi-agent-integration 2.8
Backport-base: https://github.com/earendil-works/pi/tree/v0.83.0
License: MIT (https://github.com/earendil-works/pi/blob/v0.83.0/LICENSE)
Adaptations: repository-owned Cavemem subprocess environment bootstrap.
---
 packages/coding-agent/src/runtime-bootstrap.ts | 68 ++++++++++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/packages/coding-agent/src/runtime-bootstrap.ts b/packages/coding-agent/src/runtime-bootstrap.ts
index e3ad0fb..6ae7c3b 100644
--- a/packages/coding-agent/src/runtime-bootstrap.ts
+++ b/packages/coding-agent/src/runtime-bootstrap.ts
@@ -1,6 +1,8 @@
 import { Buffer } from "node:buffer";
 
 const BOOTSTRAP_SYMBOL_KEY = "dwsr.pi-agent.runtime-bootstrap.v1";
+const CAVEMEM_ENVIRONMENT_SYMBOL_KEY = "dwsr.pi-agent.cavemem-environment.v1";
+const CAVEMEM_ENVIRONMENT_ALLOW_NAMES: readonly string[] = @cavememEnvironmentAllowlist@;
 const REDACTION_MARKER = "[REDACTED]";
 const MAX_TOKEN_BYTES = 16 * 1024;
 const PRIVATE_USE_START = 0xe000;
@@ -15,6 +17,12 @@ const SERIALIZATION_ERROR = "Pi runtime bootstrap is not serializable";
 const INPUT_ERROR = "Pi runtime bootstrap redaction input must be a string";
 const ENVIRONMENT_ERROR =
 	"Pi runtime bootstrap environment properties must be own string data properties";
+const CAVEMEM_ENVIRONMENT_DUPLICATE_ERROR =
+	"Cavemem process environment is already installed";
+const CAVEMEM_ENVIRONMENT_SERIALIZATION_ERROR =
+	"Cavemem process environment is not serializable";
+const CAVEMEM_ENVIRONMENT_ERROR =
+	"Cavemem process environment properties must be own string data properties";
 const UUID_V4_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
 
 const objectDefineProperty = Object.defineProperty;
@@ -33,5 +41,9 @@ const symbolFor = Symbol.for;
 const bufferByteLength = Buffer.byteLength;
 const bootstrapSymbol = reflectApply(symbolFor, symbolConstructor, [BOOTSTRAP_SYMBOL_KEY]) as symbol;
+const cavememEnvironmentSymbol = reflectApply(symbolFor, symbolConstructor, [
+	CAVEMEM_ENVIRONMENT_SYMBOL_KEY,
+]) as symbol;
+objectFreeze(CAVEMEM_ENVIRONMENT_ALLOW_NAMES);
 
 interface PiRuntimeBootstrapV1 {
 	readonly schemaVersion: 1;
@@ -39,6 +51,11 @@ interface PiRuntimeBootstrapV1 {
 	readonly redactExact: (value: string) => string;
 }
 
+interface CavememProcessEnvironmentV1 {
+	readonly schemaVersion: 1;
+	readonly environment: Readonly<Record<string, string>>;
+}
+
 function fail(message: string): never {
 	throw new errorConstructor(message);
 }
@@ -47,6 +64,9 @@ if (objectGetOwnPropertyDescriptor(globalThis, bootstrapSymbol) !== undefined) {
 	fail(DUPLICATE_ERROR);
 }
 
+if (objectGetOwnPropertyDescriptor(globalThis, cavememEnvironmentSymbol) !== undefined) {
+	fail(CAVEMEM_ENVIRONMENT_DUPLICATE_ERROR);
+}
 const environment = process.env;
 function readOwnEnvironmentValue(name: string): string | undefined {
 	const descriptor = objectGetOwnPropertyDescriptor(environment, name);
@@ -182,6 +202,48 @@ objectDefineProperty(capability, "toJSON", {
 	writable: false,
 });
 objectFreeze(capability);
+
+function snapshotCavememProcessEnvironment(): Readonly<Record<string, string>> {
+	const snapshot: Record<string, string> = {};
+	for (let index = 0; index < CAVEMEM_ENVIRONMENT_ALLOW_NAMES.length; index++) {
+		const name = CAVEMEM_ENVIRONMENT_ALLOW_NAMES[index];
+		const descriptor = objectGetOwnPropertyDescriptor(environment, name);
+		if (descriptor === undefined) continue;
+		if (!objectHasOwn(descriptor, "value") || typeof descriptor.value !== "string") {
+			fail(CAVEMEM_ENVIRONMENT_ERROR);
+		}
+
+		const value = descriptor.value;
+		const redactedValue = capability.redactExact(value);
+		if (redactedValue !== value) continue;
+		objectDefineProperty(snapshot, name, {
+			value,
+			configurable: false,
+			enumerable: true,
+			writable: false,
+		});
+	}
+	return objectFreeze(snapshot);
+}
+
+const cavememProcessEnvironment = snapshotCavememProcessEnvironment();
+const rejectCavememEnvironmentSerialization = objectFreeze(
+	function rejectCavememEnvironmentSerialization(): never {
+		return fail(CAVEMEM_ENVIRONMENT_SERIALIZATION_ERROR);
+	},
+);
+const cavememEnvironmentCapability: CavememProcessEnvironmentV1 = {
+	schemaVersion: 1,
+	environment: cavememProcessEnvironment,
+};
+objectDefineProperty(cavememEnvironmentCapability, "toJSON", {
+	value: rejectCavememEnvironmentSerialization,
+	configurable: false,
+	enumerable: false,
+	writable: false,
+});
+objectFreeze(cavememEnvironmentCapability);
+
 objectDefineProperty(globalThis, bootstrapSymbol, {
 	value: capability,
 	configurable: false,
@@ -188,3 +250,9 @@ objectDefineProperty(globalThis, bootstrapSymbol, {
 	enumerable: false,
 	writable: false,
 });
+objectDefineProperty(globalThis, cavememEnvironmentSymbol, {
+	value: cavememEnvironmentCapability,
+	configurable: false,
+	enumerable: false,
+	writable: false,
+});
-- 
