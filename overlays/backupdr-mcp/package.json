  "bugs": {
    "url": "https://github.com/googleapis/gcloud-mcp/issues"
  },
  "homepage": "https://github.com/googleapis/gcloud-mcp#readme",
  "description": "Model Context Protocol (MCP) Server for interacting with Google Cloud Backup and Disaster Recovery",
  "dependencies": {
    "@google-cloud/backupdr": "^0.5.0",
    "@google-cloud/compute": "^4.6.0",
    "@google-cloud/sql": "^0.24.0",
    "@modelcontextprotocol/sdk": "^1.17.1",
