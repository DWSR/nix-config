-function stashFor(sid: string): Set<string> {
-  let s = stashedFiles.get(sid);
-  if (!s) { s = new Set<string>(); stashedFiles.set(sid, s); }
-  return s;
+function contextText(result: unknown): string {
+  const text = (result as any)?.context;
+  return typeof text === "string" ? text : "";
+}
+
+function enrichmentText(result: unknown): string {
+  const text = contextText(result).slice(0, 4000);
+  return text ? `\n\n<agentmemory-enrichment>\nSupplemental memory, not file contents:\n${text}\n</agentmemory-enrichment>` : "";
+}
+
+function capturedToolOutput(output: unknown, metadata: any): unknown {
+  const span = metadata?.agentmemory_enrichment;
+  if (typeof output !== "string" || !span) return output;
+  if (Number.isSafeInteger(span.offset) && Number.isSafeInteger(span.length)
+    && span.offset >= 0 && span.length > 0 && span.offset + span.length <= output.length
+    && createHash("sha256").update(output.slice(span.offset, span.offset + span.length)).digest("hex") === span.sha256) {
+    return output.slice(0, span.offset) + output.slice(span.offset + span.length);
+  }
+  console.error("[agentmemory] Invalid enrichment span; preserving captured tool output");
+  return output;
 }
