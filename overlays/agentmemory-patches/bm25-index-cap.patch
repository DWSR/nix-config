From: nix-config <noreply@local>
Subject: [PATCH] agentmemory: bound the in-memory BM25 index

Source: src/state/search-index.ts and src/functions/search.ts
Upstream: https://github.com/DWSR/agentmemory/issues/309

Large imported corpora exhaust the Node heap because SearchIndex retains an
unbounded Map/Set graph and serialize() duplicates it into arrays. Keep the
newest configured entries, discard oversized persisted snapshots so startup
can rebuild the derived index from durable memories, bound cold-start rebuilds
to the same capacity, and reject unsafe persistence before allocating the
serialization copies.

diff --git a/src/state/search-index.ts b/src/state/search-index.ts
--- a/src/state/search-index.ts
+++ b/src/state/search-index.ts
@@ -9,6 +9,22 @@ interface IndexEntry {
   termCount: number;
 }
 
+const DEFAULT_MAX_ENTRIES = 100_000;
+const DEFAULT_MAX_PERSISTED_ENTRIES = 50_000;
+
+function positiveIntegerEnv(name: string, fallback: number): number {
+  const parsed = Number.parseInt(process.env[name] || "", 10);
+  return Number.isSafeInteger(parsed) && parsed > 0 ? parsed : fallback;
+}
+
+function configuredMaxEntries(): number {
+  return positiveIntegerEnv("AGENTMEMORY_BM25_MAX_ENTRIES", DEFAULT_MAX_ENTRIES);
+}
+
+function configuredMaxPersistedEntries(): number {
+  return positiveIntegerEnv("AGENTMEMORY_BM25_PERSIST_MAX_ENTRIES", DEFAULT_MAX_PERSISTED_ENTRIES);
+}
+
 export class SearchIndex {
   private entries: Map<string, IndexEntry> = new Map();
   private invertedIndex: Map<string, Set<string>> = new Map();
@@ -19,7 +35,16 @@ export class SearchIndex {
   private readonly k1 = 1.2;
   private readonly b = 0.75;
 
+  constructor(private readonly maxEntries = configuredMaxEntries()) {}
+
   add(obs: CompressedObservation): void {
+    if (this.entries.has(obs.id)) this.remove(obs.id);
+    while (this.entries.size >= this.maxEntries) {
+      const oldestId = this.entries.keys().next().value;
+      if (!oldestId) break;
+      this.remove(oldestId);
+    }
+
     const terms = this.extractTerms(obs);
     const termFreq = new Map<string, number>();
     let termCount = 0;
@@ -162,4 +187,7 @@ export class SearchIndex {
   get size(): number {
     return this.entries.size;
   }
+  get capacity(): number {
+    return this.maxEntries;
+  }
 
@@ -191,7 +219,12 @@ export class SearchIndex {
     this.sortedTerms = null;
   }
 
-  serialize(): string {
+  serialize(
+    maxEntries = configuredMaxPersistedEntries(),
+  ): string {
+    if (this.entries.size > maxEntries) {
+      throw new Error(`BM25 index has ${this.entries.size} entries; persistence limit is ${maxEntries}`);
+    }
     const entries = Array.from(this.entries.entries());
     const inverted = Array.from(this.invertedIndex.entries()).map(
       ([term, ids]) => [term, Array.from(ids)] as [string, string[]],
@@ -212,7 +245,18 @@ export class SearchIndex {
-  static deserialize(json: string): SearchIndex {
+  static deserialize(
+    json: string,
+    maxEntries = configuredMaxEntries(),
+  ): SearchIndex {
     try {
-      const idx = new SearchIndex();
+      const idx = new SearchIndex(maxEntries);
+      const persistedLimit = Math.min(
+        maxEntries,
+        configuredMaxPersistedEntries(),
+      );
+      if (json.length > configuredMaxPersistedEntries() * 2048) return idx;
       const data = JSON.parse(json);
       if (!data?.entries || !data?.inverted || !data?.docTerms) return idx;
+      if (!Array.isArray(data.entries) || data.entries.length >= persistedLimit) {
+        return idx;
+      }
        for (const [key, val] of data.entries) {
         idx.entries.set(key, val);
diff --git a/src/functions/search.ts b/src/functions/search.ts
--- a/src/functions/search.ts
+++ b/src/functions/search.ts
@@ -311,5 +311,14 @@ export async function rebuildIndex(kv: StateKV): Promise<number> {
   const idx = getSearchIndex()
   idx.clear()
   memoryIndexReady = false
+  const configuredRebuildLimit = Number.parseInt(
+    process.env["AGENTMEMORY_BM25_REBUILD_MAX_ENTRIES"] || "",
+    10,
+  )
+  const observationLimit =
+    Number.isSafeInteger(configuredRebuildLimit) && configuredRebuildLimit >= 0
+      ? Math.min(idx.capacity, configuredRebuildLimit)
+      : 0
+  let observationsIndexed = 0
 
   // BM25 clear above wipes stale doc entries; the vector index has the
@@ -341,3 +343,4 @@ export async function rebuildIndex(kv: StateKV): Promise<number> {
   let indexed = 0
   for (let batch = 0; batch < sessions.length; batch += 10) {
+    if (observationsIndexed >= observationLimit) break
   const chunk = sessions.slice(batch, batch + 10)
@@ -356,1 +359,5 @@ export async function rebuildIndex(kv: StateKV): Promise<number> {
-      indexed += await indexRecords(chunkObs, [])
+      const remaining = observationLimit - observationsIndexed
+      const boundedChunk = chunkObs.slice(0, remaining)
+      const count = await indexRecords(boundedChunk, [])
+      indexed += count
+      observationsIndexed += count
diff --git a/test/search-index.test.ts b/test/search-index.test.ts
--- a/test/search-index.test.ts
+++ b/test/search-index.test.ts
@@ -85,1 +85,33 @@ describe("SearchIndex", () => {
+  it("evicts the oldest entries at the configured capacity", () => {
+    const bounded = new SearchIndex(2);
+    bounded.add(makeObs({ id: "obs_a", title: "alpha" }));
+    bounded.add(makeObs({ id: "obs_b", title: "beta" }));
+    bounded.add(makeObs({ id: "obs_c", title: "gamma" }));
+
+    expect(bounded.size).toBe(2);
+    expect(bounded.search("alpha")).toEqual([]);
+    expect(bounded.search("beta")[0].obsId).toBe("obs_b");
+    expect(bounded.search("gamma")[0].obsId).toBe("obs_c");
+  });
+
+  it("refuses persistence above the configured serialization limit", () => {
+    const bounded = new SearchIndex(3);
+    bounded.add(makeObs({ id: "obs_a", title: "alpha" }));
+    bounded.add(makeObs({ id: "obs_b", title: "beta" }));
+    bounded.add(makeObs({ id: "obs_c", title: "gamma" }));
+
+    expect(() => bounded.serialize(2)).toThrow(
+      "BM25 index has 3 entries; persistence limit is 2",
+    );
+  });
+
+  it("discards persisted indexes at the configured capacity", () => {
+    const oversized = new SearchIndex(2);
+    oversized.add(makeObs({ id: "obs_a", title: "alpha" }));
+    oversized.add(makeObs({ id: "obs_b", title: "beta" }));
+
+    const restored = SearchIndex.deserialize(oversized.serialize(), 2);
+    expect(restored.size).toBe(0);
+  });
+
   it("clears the index", () => {
