#!/bin/sh
# Global hook: run prek if .pre-commit-config.yaml exists in the repo root.
# The hook stage is passed as the first argument by the dispatcher wrapper.
_prek_stage="$PREK_HOOK_STAGE"
_repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"

if [ -z "$_prek_stage" ]; then
  echo "prek hook: PREK_HOOK_STAGE not set" >&2
  exit 1
fi

if [ -f "${_repo_root}/.pre-commit-config.yaml" ]; then
  if command -v prek >/dev/null 2>&1; then
    exec prek run --hook-stage "$_prek_stage" --config "${_repo_root}/.pre-commit-config.yaml"
  fi
fi
