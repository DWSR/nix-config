import type { ExtensionAPI, ToolDefinition } from "@earendil-works/pi-coding-agent";

const LOGICAL_NAME = "@logicalName@";
const TRACE_SYMBOL = Symbol.for("dwsr.pi-agent.managed-loader-trace.v1");
const trace = Reflect.get(globalThis, TRACE_SYMBOL) as string[] | undefined;

trace?.push(`evaluate:${LOGICAL_NAME}`);

export const MCPPROXY_DIRECT_TOOL_NAMES = Object.freeze([
  "retrieve_tools",
  "describe_tool",
  "call_tool_read",
  "call_tool_write",
  "call_tool_destructive",
  "read_cache",
]);

export function validateManagedMcpSurface(
  toolNames: readonly string[],
  allowedUnrelatedToolNames: readonly string[],
): readonly string[] {
  trace?.push("validate:surface");
  const allowed = new Set([...MCPPROXY_DIRECT_TOOL_NAMES, ...allowedUnrelatedToolNames]);
  if (
    toolNames.length !== allowed.size
    || new Set(toolNames).size !== toolNames.length
    || toolNames.some((name) => !allowed.has(name))
    || MCPPROXY_DIRECT_TOOL_NAMES.some((name) => !toolNames.includes(name))
  ) {
    throw new Error("managed MCP surface mismatch");
  }
  return [...MCPPROXY_DIRECT_TOOL_NAMES];
}

export default function orderedFactory(pi: ExtensionAPI): void {
  trace?.push(`factory:${LOGICAL_NAME}`);
  if (LOGICAL_NAME !== "mcp") return;
  for (const name of MCPPROXY_DIRECT_TOOL_NAMES) {
    pi.registerTool({
      name,
      label: name,
      description: name,
      parameters: { type: "object", properties: {} },
      async execute() {
        return { content: [{ type: "text", text: name }] };
      },
    } as ToolDefinition);
  }
}
